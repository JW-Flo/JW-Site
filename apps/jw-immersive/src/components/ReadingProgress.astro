---
// Reading Progress Component
---

<div id="reading-progress" class="fixed top-0 left-0 w-full h-1 bg-slate-700 z-50">
  <div id="progress-bar" class="h-full bg-gradient-to-r from-blue-500 to-cyan-400 transition-all duration-150 ease-out"></div>
</div>

<script>
  class ReadingProgress {
    private progressBar: HTMLElement;
    private article: HTMLElement | null;

    constructor() {
      this.progressBar = document.getElementById('progress-bar')!;
      this.article = document.querySelector('article') || document.querySelector('main');

      if (this.article) {
        this.init();
      }
    }

    private init() {
      const updateProgress = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = (scrollTop / docHeight) * 100;

        this.progressBar.style.width = Math.min(scrollPercent, 100) + '%';
      };

      // Throttle scroll events for better performance
      let ticking = false;
      const handleScroll = () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            updateProgress();
            ticking = false;
          });
          ticking = true;
        }
      };

      window.addEventListener('scroll', handleScroll, { passive: true });
      updateProgress(); // Initial call
    }
  }

  // Initialize reading progress when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ReadingProgress());
  } else {
    new ReadingProgress();
  }
</script>
