---
// Blog Search Component
interface Props {
  posts: Array<{
    slug: string;
    title: string;
    date: string;
    excerpt: string;
    tags?: string[];
    readingTime?: number;
  }>;
}

const { posts } = Astro.props;
---

<div class="blog-search mb-8" data-posts='${JSON.stringify(posts)}'>
  <!-- Search Input -->
  <div class="mb-6">
    <input
      type="text"
      id="blog-search"
      placeholder="Search posts..."
      class="w-full px-4 py-3 bg-slate-800 border border-slate-600 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
    />
  </div>

  <!-- Tags Filter -->
  <div class="mb-6">
    <div class="flex flex-wrap gap-2" id="tags-container">
      <!-- Tags will be populated by JavaScript -->
    </div>
  </div>

  <!-- Results Info -->
  <div class="flex justify-between items-center text-sm text-slate-400 mb-4">
    <span id="results-count">Showing all posts</span>
    <button
      id="clear-filters"
      class="text-blue-400 hover:text-blue-300 transition-colors duration-200 hidden"
    >
      Clear filters
    </button>
  </div>
</div>

<!-- Posts Container -->
<div id="posts-container" class="space-y-6">
  <!-- Posts will be rendered here -->
</div>

<script>
  // Get posts data from data attribute
  const blogSearchElement = document.querySelector('.blog-search') as HTMLElement;
  const postsData = blogSearchElement?.dataset.posts;
  const posts = postsData ? JSON.parse(postsData) : [];
  
  // Simple version for now
  const searchInput = document.getElementById('blog-search') as HTMLInputElement;
  const postsContainer = document.getElementById('posts-container') as HTMLElement;
  const resultsCount = document.getElementById('results-count') as HTMLElement;
  
  function renderPosts(postsToRender) {
    const html = postsToRender.map(post => `
      <article class="group bg-slate-800/50 hover:bg-slate-800/80 rounded-xl p-6 border border-slate-700 hover:border-slate-600 transition-all duration-300 hover:shadow-lg hover:shadow-slate-900/50 hover:-translate-y-1">
        <a href="/blog/${post.slug}" class="block">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4 mb-4">
            <h2 class="font-bold text-xl group-hover:text-blue-400 transition-colors duration-300 leading-tight">${post.title}</h2>
            <div class="flex items-center gap-2 text-xs text-slate-400 bg-slate-700/50 px-3 py-1 rounded-full">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              ${post.readingTime} min read
            </div>
          </div>
          
          <p class="text-xs uppercase tracking-wider text-slate-500 mb-3 font-medium">${post.date}</p>
          
          ${post.tags ? `<div class="flex flex-wrap gap-2 mb-4">${post.tags.map(tag => '<span class="px-3 py-1 text-xs bg-blue-600/20 text-blue-300 rounded-full border border-blue-500/30 hover:bg-blue-600/30 transition-colors duration-200">' + tag + '</span>').join('')}</div>` : ''}
          
          <p class="text-slate-300 leading-relaxed mb-4">${post.excerpt}</p>
          
          <div class="flex items-center text-blue-400 group-hover:text-blue-300 transition-colors duration-200 font-medium">
            <span>Read more</span>
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>
      </article>
    `).join('');
    
    postsContainer.innerHTML = html;
    resultsCount.textContent = postsToRender.length === posts.length ? 'Showing all posts' : 'Showing ' + postsToRender.length + ' of ' + posts.length + ' posts';
  }
  
  // Initial render
  renderPosts(posts);
  
  // Simple search functionality
  searchInput.addEventListener('input', () => {
    const term = searchInput.value.toLowerCase();
    const filtered = posts.filter(post => 
      post.title.toLowerCase().includes(term) || 
      post.excerpt.toLowerCase().includes(term) ||
      (post.tags && post.tags.some(tag => tag.toLowerCase().includes(term)))
    );
    renderPosts(filtered);
  });
</script>
