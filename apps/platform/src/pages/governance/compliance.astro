    <script>
    // Screenshot detection logic for compliance center
    function sendScreenshotEvent(context = 'compliance') {
      const user = localStorage.getItem('atlasit_user');
      const userData = user ? JSON.parse(user) : {};
      fetch('/api/screenshot-event', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          user: userData.email || userData.company || 'unknown',
          page: window.location.pathname,
          context,
          risk_level: 'high',
          details: 'Possible screenshot detected via blur/visibilitychange.'
        })
      });
      window.dispatchEvent(new CustomEvent('atlasit-analytics', { detail: { event: 'screenshot', page: window.location.pathname, context } }));
      console.log('[Security] Screenshot event sent');
    }
    function screenshotDetectionHandler(e) {
      if (/Mobi|Android/i.test(navigator.userAgent)) {
        sendScreenshotEvent('compliance');
      }
    }
    window.addEventListener('blur', screenshotDetectionHandler);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        screenshotDetectionHandler();
      }
    });
    // AI Policy Generator logic
    document.getElementById('policy-generator-form')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      const type = document.getElementById('policy-type').value;
      const company = document.getElementById('company-name').value || 'Acme Corp';
      const params = document.getElementById('custom-parameters').value;
      let policyText = `---\n${company} ${type.replace(/-/g, ' ').toUpperCase()} Policy\n---\n`;
      policyText += `\nPolicy Type: ${type}\nCompany: ${company}\nParameters: ${params || 'default'}\n\n`;
      // Simulate AI-generated content
      policyText += `This policy was generated using AtlasIT AI Policy Generator.\n\n`;
      if (type === 'data-protection') {
        policyText += `All company data must be protected using industry-standard encryption. Data retention is governed by ${params || 'company policy'}. Access is restricted to authorized personnel only.`;
      } else if (type === 'incident-response') {
        policyText += `All incidents must be reported within 24 hours. The incident response team will investigate and document all findings. Procedures must be reviewed quarterly.`;
      } else if (type === 'access-control') {
        policyText += `Access to systems is granted based on least privilege. All access requests must be logged and reviewed. Multi-factor authentication is required for sensitive systems.`;
      } else if (type === 'privacy') {
        policyText += `Personal data is processed in accordance with GDPR and CCPA. Data subjects have the right to access, rectify, and erase their data. Privacy impact assessments are conducted annually.`;
      } else {
        policyText += `Custom policy parameters: ${params || 'none specified'}. Please review and update as needed.`;
      }
      document.getElementById('policy-output').textContent = policyText;
      document.getElementById('policy-output').style.display = 'block';
      document.getElementById('export-policy-btn').style.display = 'inline-block';
    });

    document.getElementById('export-policy-btn')?.addEventListener('click', function() {
      const policyText = document.getElementById('policy-output').textContent;
      const blob = new Blob([policyText], { type: 'text/plain' });
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `AtlasIT_Policy_${new Date().toISOString().split('T')[0]}.txt`;
      link.click();
      window.URL.revokeObjectURL(url);
    });
    // Mobile menu toggle
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    mobileMenuBtn?.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    // Close mobile menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!mobileMenuBtn?.contains(e.target) && !mobileMenu?.contains(e.target)) {
        mobileMenu?.classList.add('hidden');
      }
    });

    // Run Full Audit functionality
    document.getElementById('run-audit-btn')?.addEventListener('click', () => {
      const button = event.target;
      const originalText = button.textContent;
      
      button.textContent = 'Running Audit...';
      button.disabled = true;
      
      // Simulate audit progress
      let progress = 0;
      const progressInterval = setInterval(() => {
        progress += Math.random() * 15;
        if (progress >= 100) {
          progress = 100;
          clearInterval(progressInterval);
          
          button.textContent = 'Audit Complete!';
          
          // Update compliance scores (simulate improvements)
          setTimeout(() => {
            // Update overall score
            document.querySelector('.progress-circle span').textContent = '96%';
            
            // Update HIPAA score to show improvement
            document.querySelector('.compliance-card:nth-child(4) span').innerHTML = '<span class="px-2 py-1 bg-green-600/20 text-green-300 rounded text-xs">92% Compliant</span>';
            
            // Add new audit to timeline
            addAuditToTimeline('Full Compliance Audit', 'Just completed', 'Passed - 96% overall compliance', 'green');
            
            setTimeout(() => {
              button.textContent = originalText;
              button.disabled = false;
            }, 2000);
          }, 1000);
        }
      }, 500);
    });

    // Generate Report functionality
    document.getElementById('generate-report-btn')?.addEventListener('click', () => {
      const button = event.target;
      const originalText = button.textContent;
      
      button.textContent = 'Generating...';
      button.disabled = true;
      
      setTimeout(() => {
        // Simulate report generation
        const reportData = {
          timestamp: new Date().toLocaleString(),
          overallScore: '94%',
          standards: {
            'GDPR': '97%',
            'ISO 27001': '96%',
            'SOX': '92%',
            'HIPAA': '89%'
          },
          riskLevel: 'Medium',
          criticalIssues: 1,
          recommendations: 4
        };
        
        // Create and download report
        const reportContent = `ATLASIT COMPLIANCE REPORT
Generated: ${reportData.timestamp}

EXECUTIVE SUMMARY
Overall Compliance Score: ${reportData.overallScore}
Risk Level: ${reportData.riskLevel}
Critical Issues: ${reportData.criticalIssues}

COMPLIANCE BY STANDARD
${Object.entries(reportData.standards).map(([standard, score]) => `${standard}: ${score}`).join('\n')}

RECOMMENDATIONS
• Implement comprehensive access logging for HIPAA compliance
• Complete SOX audit documentation review
• Update incident response procedures for ISO 27001
• Review data subject rights processes for GDPR

This report was generated automatically by AtlasIT Compliance Center.
        `;
        
        const blob = new Blob([reportContent], { type: 'text/plain' });
        const url = window.URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `AtlasIT_Compliance_Report_${new Date().toISOString().split('T')[0]}.txt`;
        link.click();
        window.URL.revokeObjectURL(url);
        
        button.textContent = 'Report Generated!';
        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
        }, 2000);
      }, 2000);
    });

    // Add audit to timeline function
    function addAuditToTimeline(title, time, status, statusColor) {
      const timeline = document.querySelector('.audit-timeline');
      const newItem = document.createElement('div');
      newItem.className = 'timeline-item';
      newItem.innerHTML = `
        <div class="timeline-dot bg-${statusColor}-500"></div>
        <div class="bg-slate-800/30 rounded-lg p-3">
          <div class="font-medium text-sm">${title}</div>
          <div class="text-xs text-slate-400 mb-1">${time}</div>
          <div class="text-xs text-${statusColor}-400">✓ ${status}</div>
        </div>
      `;
      
      // Add to beginning of timeline
      timeline.insertBefore(newItem, timeline.firstChild);
    }

    // Real-time compliance monitoring simulation
    let complianceScores = {
      gdpr: 97,
      iso27001: 96,
      sox: 92,
      hipaa: 89
    };

    // Simulate periodic compliance updates
    setInterval(() => {
      // Randomly adjust scores slightly
      Object.keys(complianceScores).forEach(standard => {
        const variation = (Math.random() - 0.5) * 2; // ±1%
        complianceScores[standard] = Math.max(85, Math.min(100, complianceScores[standard] + variation));
      });
      
      // Update UI every 30 seconds (in a real system, this would come from actual monitoring)
      // For demo, we'll just occasionally show small changes
      if (Math.random() < 0.1) { // 10% chance every interval
        const randomStandard = Object.keys(complianceScores)[Math.floor(Math.random() * 4)];
        const newScore = Math.round(complianceScores[randomStandard]);
        console.log(`Compliance update: ${randomStandard.toUpperCase()} - ${newScore}%`);
      }
    }, 30000); // Every 30 seconds

    // Initialize interactive elements
    document.addEventListener('DOMContentLoaded', () => {
      // Add hover effects to compliance cards
      document.querySelectorAll('.compliance-card').forEach(card => {
        card.addEventListener('mouseenter', () => {
          card.style.transform = 'translateY(-4px)';
          card.style.boxShadow = '0 10px 25px rgba(0, 0, 0, 0.2)';
        });
        
        card.addEventListener('mouseleave', () => {
          card.style.transform = 'translateY(0)';
          card.style.boxShadow = 'none';
        });
      });
      
      // Add click handlers for compliance standard buttons
      document.querySelectorAll('.compliance-card button').forEach(button => {
        button.addEventListener('click', (e) => {
          e.preventDefault();
          const action = button.textContent.trim();
          const cardTitle = button.closest('.compliance-card').querySelector('h3').textContent;
          
          if (action === 'Run Check') {
            button.textContent = 'Checking...';
            button.disabled = true;
            
            setTimeout(() => {
              button.textContent = 'Check Complete';
              addAuditToTimeline(`${cardTitle} Check`, 'Just completed', 'Passed', 'green');
              
              setTimeout(() => {
                button.textContent = 'Run Check';
                button.disabled = false;
              }, 2000);
            }, 3000);
          } else if (action === 'Fix Issues') {
            button.textContent = 'Fixing...';
            button.disabled = true;
            
            setTimeout(() => {
              button.textContent = 'Issues Resolved';
              addAuditToTimeline(`${cardTitle} Remediation`, 'Just completed', 'Issues resolved', 'blue');
              
              setTimeout(() => {
                button.textContent = 'Run Check';
                button.disabled = false;
                button.className = button.className.replace('bg-red-600 hover:bg-red-700', 'bg-blue-600 hover:bg-blue-700');
              }, 2000);
            }, 4000);
          }
        });
      });
    });

    // Risk matrix interaction
    document.querySelectorAll('.risk-cell').forEach(cell => {
      cell.addEventListener('click', () => {
        const riskLevel = cell.textContent;
        alert(`Risk Level: ${riskLevel}\n\nClick "View Details" to see specific risk items and mitigation strategies.`);
      });
    });

    console.log('AtlasIT Compliance Center initialized - Real-time monitoring active');
  </script>

