  <title>{title}</title>
  
  <style>
    .nav-link { transition: all 0.2s ease; }
    .nav-link:hover { transform: translateY(-1px); }
    .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    .glass-effect { backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.1); }
    .input-field { transition: all 0.2s ease; }
    .input-field:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
    .demo-banner { background: linear-gradient(90deg, rgba(37,99,235,0.25), rgba(168,85,247,0.25)); border: 1px solid rgba(59,130,246,0.35); border-radius: 0.75rem; color: #bfdbfe; font-size: 0.75rem; letter-spacing: 0.08em; padding: 0.6rem 1rem; text-transform: uppercase; text-align: center; margin: 1.5rem auto 0; max-width: 60rem; }
    .compliance-card { transition: all 0.2s ease; }
    .compliance-card:hover { transform: translateY(-2px); }
    .progress-circle {
      background: conic-gradient(from 0deg, #3b82f6 0deg 288deg, #1e293b 288deg 360deg);
      border-radius: 50%;
      position: relative;
    }
    .progress-circle::before {
      content: '';
      position: absolute;
      top: 6px;
      left: 6px;
      right: 6px;
      bottom: 6px;
      background: #0f172a;
      border-radius: 50%;
    }
    .audit-timeline {
      position: relative;
    }
    .audit-timeline::before {
      content: '';
      position: absolute;
      left: 1rem;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(to bottom, #3b82f6, #8b5cf6);
    }
    .timeline-item {
      position: relative;
      padding-left: 3rem;
    }
    .timeline-dot {
      position: absolute;
      left: 0.75rem;
      top: 0.75rem;
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      transform: translateX(-50%);
    }
    .risk-matrix {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 2px;
      background: #1e293b;
      padding: 2px;
      border-radius: 4px;
    }
    .risk-cell {
      aspect-ratio: 1;
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: bold;
    }
    .risk-low { background: #22c55e; }
    .risk-medium { background: #fbbf24; }
    .risk-high { background: #ef4444; }
    .risk-critical { background: #dc2626; }
    .compliance-score {
      background: radial-gradient(circle, rgba(59,130,246,0.1) 0%, rgba(139,92,246,0.1) 100%);
    }
  </style>
</head>
