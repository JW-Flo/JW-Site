---
const title = "User Onboarding Workflow - AtlasIT";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  
  <style>
    .nav-link { transition: all 0.2s ease; }
    .nav-link:hover { transform: translateY(-1px); }
    .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    .glass-effect { backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.1); }
    .input-field { transition: all 0.2s ease; }
    .input-field:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
    .demo-banner { background: linear-gradient(90deg, rgba(37,99,235,0.25), rgba(168,85,247,0.25)); border: 1px solid rgba(59,130,246,0.35); border-radius: 0.75rem; color: #bfdbfe; font-size: 0.75rem; letter-spacing: 0.08em; padding: 0.6rem 1rem; text-transform: uppercase; text-align: center; margin: 1.5rem auto 0; max-width: 60rem; }
    .workflow-step { opacity: 0.7; transform: translateY(10px); transition: all 0.3s ease; }
    .workflow-step.active { opacity: 1; transform: translateY(0); }
    .step-number { 
      background: linear-gradient(135deg, #3b82f6, #8b5cf6); 
      width: 2rem; 
      height: 2rem; 
      border-radius: 50%; 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      color: white; 
      font-weight: bold; 
      font-size: 0.875rem;
    }
    .trigger-option { 
      cursor: pointer; 
      transition: all 0.2s ease; 
    }
    .trigger-option:hover { 
      background: rgba(59, 130, 246, 0.1); 
      border-color: #3b82f6; 
    }
    .trigger-option.selected { 
      background: rgba(59, 130, 246, 0.2); 
      border-color: #3b82f6; 
    }
    .action-card {
      background: rgba(30, 41, 59, 0.5);
      border: 1px solid #475569;
      border-radius: 0.75rem;
      padding: 1.5rem;
      transition: all 0.2s ease;
    }
    .action-card:hover {
      border-color: #64748b;
      background: rgba(30, 41, 59, 0.7);
    }
    .progress-bar {
      background: linear-gradient(90deg, #3b82f6 0%, #8b5cf6 100%);
      height: 4px;
      border-radius: 2px;
      transition: width 0.3s ease;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-slate-100 min-h-screen">
  <!-- Header -->
  <header class="glass-effect border-b border-slate-700/50 sticky top-0 z-50">
    <nav class="container mx-auto px-6 py-4">
      <div class="flex justify-between items-center">
        <div class="flex items-center space-x-2">
          <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-purple-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-sm">AI</span>
          </div>
          <h1 class="text-xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">AtlasIT</h1>
        </div>

        <!-- Breadcrumb Navigation -->
        <div class="hidden md:flex items-center space-x-2 text-sm text-slate-400">
          <a href="/dashboard" class="hover:text-slate-300 transition-colors">Dashboard</a>
          <span>›</span>
          <a href="/orchestrator" class="hover:text-slate-300 transition-colors">Orchestrator</a>
          <span>›</span>
          <span class="text-slate-100">User Onboarding</span>
        </div>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-1">
          <a href="/dashboard" class="nav-link px-4 py-2 rounded-lg hover:bg-slate-700/50 text-slate-300 hover:text-white transition-all duration-200">Dashboard</a>
          <a href="/orchestrator" class="nav-link px-4 py-2 rounded-lg bg-blue-600 text-white transition-all duration-200">Orchestrator</a>
          <a href="/login" class="nav-link px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white transition-all duration-200">Login</a>
        </div>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden text-slate-300 hover:text-white p-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </nav>
  </header>

  <div class="demo-banner">Demo Mode · Sample data resets regularly and is not production</div>

  <!-- Main Content -->
  <main class="container mx-auto px-6 py-8">
    <!-- Header Section -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h1 class="text-3xl font-bold mb-2">User Onboarding Workflow</h1>
          <p class="text-slate-400">Automate new user setup, permissions, and notifications</p>
        </div>
        <div class="flex items-center space-x-3">
          <button id="reset-demo" class="px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white rounded-lg transition-colors">
            Reset Demo Data
          </button>
          <button id="test-workflow" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors">
            Test Workflow
          </button>
          <button id="save-workflow" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
            Save Changes
          </button>
        </div>
      </div>
      
      <!-- Progress Indicator -->
      <div class="mb-6">
        <div class="flex items-center justify-between text-sm text-slate-400 mb-2">
          <span>Workflow Configuration Progress</span>
          <span id="progress-text">0% Complete</span>
        </div>
        <div class="w-full bg-slate-700 rounded-full h-1">
          <div id="progress-bar" class="progress-bar w-0"></div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column: Workflow Configuration -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Step 1: Basic Information -->
        <div class="workflow-step active glass-effect p-6 rounded-xl border border-slate-700/50" id="step-1">
          <div class="flex items-center mb-6">
            <div class="step-number mr-4">1</div>
            <h2 class="text-xl font-semibold">Basic Information</h2>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">Tenant Name</label>
              <input 
                type="text" 
                id="tenant-name"
                value="HardWorkCo"
                class="input-field w-full px-4 py-3 bg-slate-800/50 border border-slate-600 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none" 
                required
              >
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">Workflow Name</label>
              <input 
                type="text" 
                id="workflow-name"
                value="User Onboarding Automation"
                class="input-field w-full px-4 py-3 bg-slate-800/50 border border-slate-600 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none" 
                required
              >
            </div>
            
            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">Priority Level</label>
              <select id="priority-level" class="input-field w-full px-4 py-3 bg-slate-800/50 border border-slate-600 rounded-lg text-slate-100 focus:outline-none">
                <option value="high">High Priority</option>
                <option value="medium" selected>Medium Priority</option>
                <option value="low">Low Priority</option>
              </select>
            </div>
          </div>

          <div class="mt-4">
            <label class="block text-sm font-medium text-slate-300 mb-2">Description</label>
            <textarea 
              id="workflow-description"
              placeholder="Describe what this workflow accomplishes..."
              rows="3" 
              class="input-field w-full px-4 py-3 bg-slate-800/50 border border-slate-600 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none resize-none"
            >Automatically set up new users with proper permissions, notification preferences, and required integrations for HardWorkCo employees.</textarea>
          </div>
        </div>

        <!-- Step 2: Trigger Configuration -->
        <div class="workflow-step glass-effect p-6 rounded-xl border border-slate-700/50" id="step-2">
          <div class="flex items-center mb-6">
            <div class="step-number mr-4">2</div>
            <h2 class="text-xl font-semibold">Trigger Configuration</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="trigger-option border border-slate-600 rounded-lg p-4 text-center" data-trigger="manual">
              <div class="text-2xl mb-2">🚀</div>
              <h3 class="font-medium mb-2">Manual</h3>
              <p class="text-sm text-slate-400">Run manually when needed</p>
            </div>
            
            <div class="trigger-option border border-slate-600 rounded-lg p-4 text-center selected" data-trigger="event">
              <div class="text-2xl mb-2">⚡</div>
              <h3 class="font-medium mb-2">Event</h3>
              <p class="text-sm text-slate-400">Trigger on user creation</p>
            </div>
            
            <div class="trigger-option border border-slate-600 rounded-lg p-4 text-center" data-trigger="schedule">
              <div class="text-2xl mb-2">⏰</div>
              <h3 class="font-medium mb-2">Schedule</h3>
              <p class="text-sm text-slate-400">Run on a schedule</p>
            </div>
          </div>

          <div id="trigger-details">
            <label class="block text-sm font-medium text-slate-300 mb-2">Event Type</label>
            <select class="input-field w-full px-4 py-3 bg-slate-800/50 border border-slate-600 rounded-lg text-slate-100 focus:outline-none">
              <option value="user_created">New User Created</option>
              <option value="user_activated">User Account Activated</option>
              <option value="role_assigned">Role Assigned to User</option>
            </select>
          </div>
        </div>

        <!-- Step 3: Workflow Actions -->
        <div class="workflow-step glass-effect p-6 rounded-xl border border-slate-700/50" id="step-3">
          <div class="flex items-center mb-6">
            <div class="step-number mr-4">3</div>
            <h2 class="text-xl font-semibold">Workflow Actions</h2>
          </div>

          <div class="space-y-4" id="workflow-actions">
            <!-- Action 1: Create User Account -->
            <div class="action-card">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center">
                  <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center mr-3">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                  </div>
                  <h3 class="font-medium">Create User Account</h3>
                </div>
                <button class="text-slate-400 hover:text-slate-300">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                  </svg>
                </button>
              </div>
              <p class="text-sm text-slate-400 mb-3">Generate username, set initial password, create directory structure</p>
              <div class="text-xs text-slate-500">Status: Active • Timeout: 30s • Retry: 3 attempts</div>
            </div>

            <!-- Action 2: Assign Permissions -->
            <div class="action-card">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center">
                  <div class="w-8 h-8 bg-green-600 rounded-lg flex items-center justify-center mr-3">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                  </div>
                  <h3 class="font-medium">Assign Permissions</h3>
                </div>
                <button class="text-slate-400 hover:text-slate-300">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                  </svg>
                </button>
              </div>
              <p class="text-sm text-slate-400 mb-3">Apply role-based permissions, group memberships, and access policies</p>
              <div class="text-xs text-slate-500">Status: Active • Timeout: 60s • Retry: 2 attempts</div>
            </div>

            <!-- Action 3: Send Welcome Email -->
            <div class="action-card">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center">
                  <div class="w-8 h-8 bg-purple-600 rounded-lg flex items-center justify-center mr-3">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <h3 class="font-medium">Send Welcome Email</h3>
                </div>
                <button class="text-slate-400 hover:text-slate-300">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                  </svg>
                </button>
              </div>
              <p class="text-sm text-slate-400 mb-3">Send personalized welcome email with login instructions and resources</p>
              <div class="text-xs text-slate-500">Status: Active • Timeout: 15s • Retry: 1 attempt</div>
            </div>

            <!-- Action 4: Setup Integrations -->
            <div class="action-card">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center">
                  <div class="w-8 h-8 bg-orange-600 rounded-lg flex items-center justify-center mr-3">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <h3 class="font-medium">Setup Integrations</h3>
                </div>
                <button class="text-slate-400 hover:text-slate-300">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                  </svg>
                </button>
              </div>
              <p class="text-sm text-slate-400 mb-3">Configure Slack, Teams, and other service integrations</p>
              <div class="text-xs text-slate-500">Status: Active • Timeout: 45s • Retry: 3 attempts</div>
            </div>
          </div>

          <button id="add-action" class="mt-4 w-full border-2 border-dashed border-slate-600 hover:border-slate-500 rounded-lg py-4 text-slate-400 hover:text-slate-300 transition-colors">
            + Add New Action
          </button>
        </div>

        <!-- Step 4: Error Handling -->
        <div class="workflow-step glass-effect p-6 rounded-xl border border-slate-700/50" id="step-4">
          <div class="flex items-center mb-6">
            <div class="step-number mr-4">4</div>
            <h2 class="text-xl font-semibold">Error Handling & Notifications</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">On Failure Action</label>
              <select class="input-field w-full px-4 py-3 bg-slate-800/50 border border-slate-600 rounded-lg text-slate-100 focus:outline-none">
                <option value="retry">Retry Failed Steps</option>
                <option value="rollback">Rollback Changes</option>
                <option value="notify">Notify Admin Only</option>
                <option value="continue">Continue Workflow</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">Notification Recipients</label>
              <input 
                type="email" 
                placeholder="admin@company.com"
                class="input-field w-full px-4 py-3 bg-slate-800/50 border border-slate-600 rounded-lg text-slate-100 placeholder-slate-400 focus:outline-none"
              >
            </div>
          </div>

          <div class="mt-4">
            <label class="flex items-center">
              <input type="checkbox" class="mr-2" checked>
              <span class="text-sm text-slate-300">Send success notifications</span>
            </label>
            <label class="flex items-center mt-2">
              <input type="checkbox" class="mr-2" checked>
              <span class="text-sm text-slate-300">Log all workflow executions</span>
            </label>
            <label class="flex items-center mt-2">
              <input type="checkbox" class="mr-2">
              <span class="text-sm text-slate-300">Enable debugging mode</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Right Column: Workflow Preview & Status -->
      <div class="space-y-6">
        <!-- Workflow Status -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <h3 class="text-lg font-semibold mb-4">Workflow Status</h3>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-300">Status</span>
              <span class="px-2 py-1 bg-green-600/20 text-green-300 rounded text-xs">Active</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-300">Last Run</span>
              <span class="text-xs text-slate-400">2 hours ago</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-300">Success Rate</span>
              <span class="text-xs text-green-300">94%</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-300">Avg Runtime</span>
              <span class="text-xs text-slate-400">2.3 minutes</span>
            </div>
          </div>
        </div>

        <!-- Recent Executions -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <h3 class="text-lg font-semibold mb-4">Recent Executions</h3>
          <div class="space-y-3">
            <div class="flex items-center justify-between p-3 bg-slate-800/30 rounded-lg">
              <div>
                <div class="text-sm font-medium">john.doe@company.com</div>
                <div class="text-xs text-slate-400">2 hours ago</div>
              </div>
              <span class="px-2 py-1 bg-green-600/20 text-green-300 rounded text-xs">Success</span>
            </div>
            <div class="flex items-center justify-between p-3 bg-slate-800/30 rounded-lg">
              <div>
                <div class="text-sm font-medium">jane.smith@company.com</div>
                <div class="text-xs text-slate-400">4 hours ago</div>
              </div>
              <span class="px-2 py-1 bg-green-600/20 text-green-300 rounded text-xs">Success</span>
            </div>
            <div class="flex items-center justify-between p-3 bg-slate-800/30 rounded-lg">
              <div>
                <div class="text-sm font-medium">mike.wilson@company.com</div>
                <div class="text-xs text-slate-400">6 hours ago</div>
              </div>
              <span class="px-2 py-1 bg-red-600/20 text-red-300 rounded text-xs">Failed</span>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <h3 class="text-lg font-semibold mb-4">Quick Actions</h3>
          <div class="space-y-2">
            <button class="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors text-sm">
              Run Manual Test
            </button>
            <button class="w-full px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors text-sm">
              View Execution Logs
            </button>
            <button class="w-full px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors text-sm">
              Export Configuration
            </button>
            <button class="w-full px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors text-sm">
              Disable Workflow
            </button>
          </div>
        </div>

        <!-- Demo Information -->
        <div class="glass-effect p-6 rounded-xl border border-yellow-700/50 bg-yellow-900/10">
          <h3 class="text-lg font-semibold mb-4 text-yellow-300">Demo Mode Information</h3>
          <div class="space-y-3 text-sm">
            <div class="flex items-start">
              <div class="w-2 h-2 bg-yellow-400 rounded-full mt-2 mr-3 flex-shrink-0"></div>
              <div>
                <div class="font-medium text-yellow-200">Default Tenant: HardWorkCo</div>
                <div class="text-yellow-300/80">Demo company with 150 employees</div>
              </div>
            </div>
            <div class="flex items-start">
              <div class="w-2 h-2 bg-yellow-400 rounded-full mt-2 mr-3 flex-shrink-0"></div>
              <div>
                <div class="font-medium text-yellow-200">Sample Users</div>
                <div class="text-yellow-300/80">Pre-configured with IT, HR, and Finance departments</div>
              </div>
            </div>
            <div class="flex items-start">
              <div class="w-2 h-2 bg-yellow-400 rounded-full mt-2 mr-3 flex-shrink-0"></div>
              <div>
                <div class="font-medium text-yellow-200">Auto-Reset</div>
                <div class="text-yellow-300/80">Demo data automatically resets every 24 hours</div>
              </div>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-yellow-700/50">
            <p class="text-xs text-yellow-300/70">
              Use "Reset Demo Data" button to restore default HardWorkCo settings anytime
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="glass-effect border-t border-slate-700/50 mt-16">
    <div class="container mx-auto px-6 py-8">
      <div class="flex flex-col md:flex-row justify-between items-center">
        <div class="flex items-center space-x-2 mb-4 md:mb-0">
          <div class="w-6 h-6 bg-gradient-to-r from-blue-500 to-purple-600 rounded flex items-center justify-center">
            <span class="text-white font-bold text-xs">AI</span>
          </div>
          <span class="text-slate-400">© 2025 AtlasIT. Enterprise IT Automation Platform.</span>
        </div>
        <div class="flex space-x-6 text-sm text-slate-400">
          <a href="#" class="hover:text-slate-300 transition-colors">Privacy</a>
          <a href="#" class="hover:text-slate-300 transition-colors">Terms</a>
          <a href="#" class="hover:text-slate-300 transition-colors">Support</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    // Mobile menu toggle
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    mobileMenuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });

    // Trigger type selection
    document.querySelectorAll('.trigger-option').forEach(option => {
      option.addEventListener('click', () => {
        document.querySelectorAll('.trigger-option').forEach(opt => opt.classList.remove('selected'));
        option.classList.add('selected');
        updateProgress();
      });
    });

    // Progress tracking
    function updateProgress() {
      const tenantName = document.getElementById('tenant-name').value;
      const workflowName = document.getElementById('workflow-name').value;
      const description = document.getElementById('workflow-description').value;
      const selectedTrigger = document.querySelector('.trigger-option.selected');
      
      let progress = 0;
      if (tenantName.trim()) progress += 20;
      if (workflowName.trim()) progress += 20;
      if (description.trim()) progress += 20;
      if (selectedTrigger) progress += 20;
      
      // Check if actions are configured (simplified)
      const actions = document.querySelectorAll('.action-card');
      if (actions.length > 0) progress += 20;
      
      const progressBar = document.getElementById('progress-bar');
      const progressText = document.getElementById('progress-text');
      
      progressBar.style.width = progress + '%';
      progressText.textContent = progress + '% Complete';
      
      // Show appropriate workflow steps
      const steps = document.querySelectorAll('.workflow-step');
      steps.forEach((step, index) => {
        if (progress >= (index + 1) * 20 || index === 0) {
          step.classList.add('active');
        }
      });
    }

    // Form field change handlers
    ['tenant-name', 'workflow-name', 'workflow-description'].forEach(id => {
      const element = document.getElementById(id);
      if (element) {
        element.addEventListener('input', updateProgress);
      }
    });

    // Reset demo data functionality
    document.getElementById('reset-demo')?.addEventListener('click', () => {
      const button = event.target;
      const originalText = button.textContent;
      
      // Confirm reset
      if (!confirm('This will reset all form data to HardWorkCo demo defaults. Continue?')) {
        return;
      }
      
      button.textContent = 'Resetting...';
      button.disabled = true;
      
      setTimeout(() => {
        // Reset all form fields to demo defaults
        document.getElementById('tenant-name').value = 'HardWorkCo';
        document.getElementById('workflow-name').value = 'User Onboarding Automation';
        document.getElementById('priority-level').value = 'medium';
        document.getElementById('workflow-description').value = 'Automatically set up new users with proper permissions, notification preferences, and required integrations for HardWorkCo employees.';
        
        // Reset trigger selection
        document.querySelectorAll('.trigger-option').forEach(opt => opt.classList.remove('selected'));
        document.querySelector('.trigger-option[data-trigger="event"]').classList.add('selected');
        
        // Update progress
        updateProgress();
        
        button.textContent = 'Demo Reset Complete!';
        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
        }, 1500);
      }, 1000);
    });

    // Save workflow
    document.getElementById('save-workflow')?.addEventListener('click', () => {
      // Simulate save
      const button = event.target;
      const originalText = button.textContent;
      button.textContent = 'Saving...';
      button.disabled = true;
      
      setTimeout(() => {
        button.textContent = 'Saved!';
        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
        }, 1000);
      }, 1500);
    });

    // Test workflow
    document.getElementById('test-workflow')?.addEventListener('click', () => {
      const button = event.target;
      const originalText = button.textContent;
      button.textContent = 'Testing...';
      button.disabled = true;
      
      setTimeout(() => {
        button.textContent = 'Test Complete!';
        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
        }, 1000);
      }, 3000);
    });

    // Initialize progress
    updateProgress();

    // Close mobile menu when clicking outside
    document.addEventListener('click', (e) => {
      if (mobileMenu && !mobileMenuBtn?.contains(e.target) && !mobileMenu?.contains(e.target)) {
        mobileMenu?.classList.add('hidden');
      }
    });
  </script>
</body>
</html>
