---
// API endpoint for onboarding form submission
---

<script>
export async function POST({ request }) {
  try {
    const body = await request.json();
    
    // Validate tenant ID format (alphanumeric, dashes, underscores allowed)
    const tenantIdPattern = /^[a-zA-Z0-9_-]+$/;
    if (body.tenantId && !tenantIdPattern.test(body.tenantId)) {
      return new Response(JSON.stringify({
        error: "Invalid tenant ID format. Use only letters, numbers, dashes, and underscores.",
        code: "INVALID_TENANT_ID"
      }), {
        status: 400,
        headers: { 'Content-Type': 'application/json' }
      });
    }

    // Validate required fields
    const requiredFields = ['tenantId', 'name', 'industry'];
    for (const field of requiredFields) {
      if (!body[field]) {
        return new Response(JSON.stringify({
          error: `Missing required field: ${field}`,
          code: "MISSING_FIELD"
        }), {
          status: 400,
          headers: { 'Content-Type': 'application/json' }
        });
      }
    }

    // Simulate onboarding process
    const onboardingResult = {
      success: true,
      tenantId: body.tenantId,
      companyName: body.name,
      industry: body.industry,
      timestamp: new Date().toISOString(),
      
      // Simulated configuration based on input
      configuration: {
        oktaOrg: `${body.tenantId}.atlasit.okta.com`,
        awsAccountId: `${Math.floor(100000000000 + Math.random() * 900000000000)}`,
        paycomClientId: `paycom_${body.tenantId}`,
        
        // Industry-specific defaults
        defaultApplications: getDefaultApplications(body.industry),
        complianceRequirements: getComplianceRequirements(body.industry),
        
        // Generated access policies
        iamPolicies: generateIAMPolicies(body.industry),
        oktaGroups: generateOktaGroups(body.industry)
      },
      
      // Next steps
      nextSteps: [
        "Complete Okta domain verification",
        "Configure AWS cross-account trust",
        "Install Paycom webhook integration",
        "Test JML workflows",
        "Go live with automated onboarding"
      ]
    };

    return new Response(JSON.stringify(onboardingResult), {
      status: 200,
      headers: { 'Content-Type': 'application/json' }
    });

  } catch (error) {
    return new Response(JSON.stringify({
      error: "Internal server error",
      code: "SERVER_ERROR",
      details: error.message
    }), {
      status: 500,
      headers: { 'Content-Type': 'application/json' }
    });
  }
}

function getDefaultApplications(industry) {
  const baseApps = ['Slack', 'Office 365', 'Okta', 'VPN Access'];
  
  const industryApps = {
    technology: ['GitHub', 'JIRA', 'Confluence', 'AWS Console', 'Docker Hub'],
    healthcare: ['Epic', 'Cerner', 'HIPAA Vault', 'Medical Billing'],
    finance: ['QuickBooks', 'Sage', 'Bloomberg Terminal', 'Financial Planning'],
    manufacturing: ['SAP', 'MES System', 'Quality Control', 'Inventory Management'],
    retail: ['POS System', 'Inventory Management', 'Customer Management', 'E-commerce Platform'],
    education: ['LMS', 'Student Information System', 'Research Tools', 'Academic Calendar']
  };
  
  return [...baseApps, ...(industryApps[industry] || industryApps.technology)];
}

function getComplianceRequirements(industry) {
  const complianceMap = {
    technology: ['SOC 2', 'ISO 27001'],
    healthcare: ['HIPAA', 'SOC 2', 'HITECH'],
    finance: ['SOX', 'PCI DSS', 'GLBA'],
    manufacturing: ['ISO 27001', 'SOC 2'],
    retail: ['PCI DSS', 'SOC 2'],
    education: ['FERPA', 'SOC 2']
  };
  
  return complianceMap[industry] || complianceMap.technology;
}

function generateIAMPolicies(industry) {
  return [
    {
      name: `${industry}-developer-policy`,
      description: `Standard developer access for ${industry} industry`,
      permissions: ['s3:GetObject', 's3:PutObject', 'ec2:DescribeInstances', 'logs:CreateLogGroup']
    },
    {
      name: `${industry}-admin-policy`, 
      description: `Administrative access for ${industry} industry`,
      permissions: ['*']
    }
  ];
}

function generateOktaGroups(industry) {
  return [
    `${industry}-developers`,
    `${industry}-managers`,
    `${industry}-admins`,
    'all-employees',
    'contractors'
  ];
}
</script>
