---
const title = "Slack Integration - AtlasIT Marketplace";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  
  <style>
    .nav-link { transition: all 0.2s ease; }
    .nav-link:hover { transform: translateY(-1px); }
    .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    .glass-effect { backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.1); }
    .input-field { transition: all 0.2s ease; }
    .input-field:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
    .demo-banner { background: linear-gradient(90deg, rgba(37,99,235,0.25), rgba(168,85,247,0.25)); border: 1px solid rgba(59,130,246,0.35); border-radius: 0.75rem; color: #bfdbfe; font-size: 0.75rem; letter-spacing: 0.08em; padding: 0.6rem 1rem; text-transform: uppercase; text-align: center; margin: 1.5rem auto 0; max-width: 60rem; }
    .feature-card { transition: all 0.2s ease; }
    .feature-card:hover { transform: translateY(-2px); }
    .badge-simulated { display: inline-flex; align-items: center; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; background: rgba(250, 204, 21, 0.18); border: 1px solid rgba(250, 204, 21, 0.45); color: #fef08a; }
    .simulated-callout { border: 1px solid rgba(250, 204, 21, 0.35); border-radius: 0.75rem; padding: 1rem 1.25rem; background: rgba(250, 204, 21, 0.08); }
    .simulated-note { color: #cbd5f5; font-size: 0.85rem; line-height: 1.4; margin-top: 0.75rem; }
    .simulated-history__item { border: 1px solid rgba(148, 163, 184, 0.35); background: rgba(15, 23, 42, 0.4); border-radius: 0.75rem; padding: 0.85rem 1rem; display: flex; justify-content: space-between; align-items: center; }
    .simulated-history__title { font-size: 0.95rem; font-weight: 600; color: #e2e8f0; margin: 0; }
    .simulated-history__meta { font-size: 0.75rem; color: #94a3b8; margin-top: 0.35rem; }
  </style>
</head>
<body class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-slate-100 min-h-screen">
  <!-- Header -->
  <header class="glass-effect border-b border-slate-700/50 sticky top-0 z-50">
    <nav class="container mx-auto px-6 py-4">
      <div class="flex justify-between items-center">
        <div class="flex items-center space-x-2">
          <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-purple-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-sm">AI</span>
          </div>
          <h1 class="text-xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">AtlasIT</h1>
        </div>

        <!-- Breadcrumb Navigation -->
        <div class="hidden md:flex items-center space-x-2 text-sm text-slate-400">
          <a href="/dashboard" class="hover:text-slate-300 transition-colors">Dashboard</a>
          <span>›</span>
          <a href="/marketplace" class="hover:text-slate-300 transition-colors">Marketplace</a>
          <span>›</span>
          <span class="text-slate-100">Slack Integration</span>
        </div>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-1">
          <a href="/dashboard" class="nav-link px-4 py-2 rounded-lg hover:bg-slate-700/50 text-slate-300 hover:text-white transition-all duration-200">Dashboard</a>
          <a href="/marketplace" class="nav-link px-4 py-2 rounded-lg bg-blue-600 text-white transition-all duration-200">Marketplace</a>
          <a href="/login" class="nav-link px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white transition-all duration-200">Login</a>
        </div>
      </div>
    </nav>
  </header>

  <div class="demo-banner">Demo Mode · Sample data resets regularly and is not production</div>

  <!-- Main Content -->
  <main class="container mx-auto px-6 py-8">
    <!-- Integration Header -->
    <div class="glass-effect p-8 rounded-xl border border-slate-700/50 mb-8">
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <div class="w-16 h-16 bg-gradient-to-r from-purple-600 to-pink-600 rounded-xl flex items-center justify-center mr-6">
            <svg class="w-10 h-10 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M5.042 15.165a2.528 2.528 0 0 1-2.52-2.523A2.528 2.528 0 0 1 5.042 10.12a2.528 2.528 0 0 1 2.52 2.522 2.528 2.528 0 0 1-2.52 2.523m6.906 4.402c-.98 3.183-5.226 4.66-8.72 2.346-1.445-.956-2.43-2.526-2.43-4.31 0-2.19 1.378-4.04 3.305-4.75 1.927-.71 4.1-.29 5.53 1.07.716.68 1.17 1.602 1.315 2.644m-13.84-7.454c.98-3.183 5.226-4.66 8.72-2.346 1.445.956 2.43 2.526 2.43 4.31 0 2.19-1.378 4.04-3.305 4.75-1.927.71-4.1.29-5.53-1.07A4.402 4.402 0 0 1-.892 12.113M18.958 8.835a2.528 2.528 0 0 1 2.52 2.523 2.528 2.528 0 0 1-2.52 2.522 2.528 2.528 0 0 1-2.52-2.522 2.528 2.528 0 0 1 2.52-2.523m-6.906-4.402c.98-3.183 5.226-4.66 8.72-2.346 1.445.956 2.43 2.526 2.43 4.31 0 2.19-1.378 4.04-3.305 4.75-1.927.71-4.1.29-5.53-1.07a4.402 4.402 0 0 1-1.315-2.644m13.84 7.454c-.98 3.183-5.226 4.66-8.72 2.346-1.445-.956-2.43-2.526-2.43-4.31 0-2.19 1.378-4.04 3.305-4.75 1.927-.71 4.1-.29 5.53 1.07.716.68 1.17 1.602 1.315 2.644"/>
            </svg>
          </div>
          <div>
            <h1 class="text-3xl font-bold mb-2">Slack Integration</h1>
            <p class="text-slate-400">Connect your team communication with automated workflows</p>
            <div class="flex items-center mt-3">
              <div class="flex text-yellow-400 mr-2">
                <span>★★★★★</span>
              </div>
              <span class="text-sm text-slate-400">4.9 (2,847 reviews) • Free to install</span>
            </div>
          </div>
        </div>
        <div class="text-right">
          <button class="px-6 py-3 bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors font-medium mb-2">
            Install Integration
          </button>
          <div class="text-sm text-slate-400">
            <div>Compatible with Slack Enterprise</div>
            <div>Last updated: 2 days ago</div>
          </div>
        </div>
      </div>
    </div>

    <div class="glass-effect simulated-callout mb-8">
      <span class="badge-simulated">Simulated Connector</span>
      <p class="simulated-note">This Slack integration currently runs in AtlasIT&rsquo;s simulated connector environment. Review the sample events and approvals before connecting your production workspace. When you have production tokens, follow the transition steps in the Orchestrator documentation to register the real connector.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column: Features & Configuration -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Key Features -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <h2 class="text-xl font-semibold mb-6">Key Features</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="feature-card bg-slate-800/30 rounded-lg p-4">
              <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center mb-3">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h3 class="font-medium mb-2">Real-time Alerts</h3>
              <p class="text-sm text-slate-400">Get instant notifications for system events, security alerts, and workflow status updates.</p>
            </div>

            <div class="feature-card bg-slate-800/30 rounded-lg p-4">
              <div class="w-8 h-8 bg-green-600 rounded-lg flex items-center justify-center mb-3">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h3 class="font-medium mb-2">Workflow Approvals</h3>
              <p class="text-sm text-slate-400">Approve user access requests, policy changes, and system modifications directly from Slack.</p>
            </div>

            <div class="feature-card bg-slate-800/30 rounded-lg p-4">
              <div class="w-8 h-8 bg-purple-600 rounded-lg flex items-center justify-center mb-3">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 012-2h2a2 2 0 012 2v6a2 2 0 01-2 2h-2a2 2 0 01-2-2v-6z"></path>
                </svg>
              </div>
              <h3 class="font-medium mb-2">Status Dashboard</h3>
              <p class="text-sm text-slate-400">View system health, backup status, and security metrics in dedicated Slack channels.</p>
            </div>

            <div class="feature-card bg-slate-800/30 rounded-lg p-4">
              <div class="w-8 h-8 bg-orange-600 rounded-lg flex items-center justify-center mb-3">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <h3 class="font-medium mb-2">Slash Commands</h3>
              <p class="text-sm text-slate-400">Execute AtlasIT commands directly from Slack with /atlasit shortcuts.</p>
            </div>
          </div>
        </div>

        <!-- Setup Configuration -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <h2 class="text-xl font-semibold mb-6">Setup & Configuration</h2>

          <div class="space-y-6">
            <!-- Step 1: Workspace Connection -->
            <div class="border-l-4 border-blue-600 pl-4">
              <h3 class="font-medium mb-2">1. Connect Slack Workspace</h3>
              <p class="text-sm text-slate-400 mb-3">Authorize AtlasIT to access your Slack workspace</p>
              <button class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors text-sm">
                Connect to Slack
              </button>
            </div>

            <!-- Step 2: Channel Configuration -->
            <div class="border-l-4 border-yellow-600 pl-4">
              <h3 class="font-medium mb-2">2. Configure Channels</h3>
              <p class="text-sm text-slate-400 mb-3">Select channels for different types of notifications</p>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-slate-300 mb-2">Alerts Channel</label>
                  <select class="input-field w-full px-3 py-2 bg-slate-800/50 border border-slate-600 rounded text-slate-100 text-sm">
                    <option value=""># Select channel...</option>
                    <option value="alerts"># alerts</option>
                    <option value="security"># security</option>
                    <option value="it-ops"># it-ops</option>
                  </select>
                </div>
                
                <div>
                  <label class="block text-sm font-medium text-slate-300 mb-2">Approvals Channel</label>
                  <select class="input-field w-full px-3 py-2 bg-slate-800/50 border border-slate-600 rounded text-slate-100 text-sm">
                    <option value=""># Select channel...</option>
                    <option value="approvals"># approvals</option>
                    <option value="admin"># admin</option>
                    <option value="management"># management</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Step 3: Notification Settings -->
            <div class="border-l-4 border-green-600 pl-4">
              <h3 class="font-medium mb-2">3. Notification Preferences</h3>
              <p class="text-sm text-slate-400 mb-3">Choose what events trigger Slack notifications</p>
              
              <div class="grid grid-cols-2 gap-2 text-sm">
                <label class="flex items-center"><input type="checkbox" class="mr-2" checked> Security Incidents</label>
                <label class="flex items-center"><input type="checkbox" class="mr-2" checked> Backup Failures</label>
                <label class="flex items-center"><input type="checkbox" class="mr-2" checked> User Onboarding</label>
                <label class="flex items-center"><input type="checkbox" class="mr-2"> System Updates</label>
                <label class="flex items-center"><input type="checkbox" class="mr-2" checked> Policy Violations</label>
                <label class="flex items-center"><input type="checkbox" class="mr-2"> Maintenance Windows</label>
              </div>
            </div>

            <!-- Step 4: Slash Commands -->
            <div class="border-l-4 border-purple-600 pl-4">
              <h3 class="font-medium mb-2">4. Enable Slash Commands</h3>
              <p class="text-sm text-slate-400 mb-3">Allow team members to interact with AtlasIT from Slack</p>
              
              <div class="bg-slate-800/30 rounded-lg p-3 text-sm">
                <div class="font-mono text-blue-300 mb-2">Available Commands:</div>
                <div class="space-y-1 text-slate-400">
                  <div><span class="text-blue-300">/atlasit status</span> - View system status</div>
                  <div><span class="text-blue-300">/atlasit backup</span> - Check backup status</div>
                  <div><span class="text-blue-300">/atlasit user [email]</span> - Look up user info</div>
                  <div><span class="text-blue-300">/atlasit help</span> - Show all commands</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Example Notifications -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <h2 class="text-xl font-semibold mb-6">Example Notifications</h2>

          <div class="space-y-4">
            <!-- Security Alert -->
            <div class="bg-red-900/20 border border-red-700/50 rounded-lg p-4">
              <div class="flex items-center mb-2">
                <div class="w-6 h-6 bg-red-600 rounded flex items-center justify-center mr-2">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                  </svg>
                </div>
                <span class="font-medium text-red-300">Security Alert</span>
              </div>
              <p class="text-sm text-slate-300 mb-2">🚨 **Suspicious login detected**</p>
              <p class="text-sm text-slate-400">User: john.doe@company.com<br>IP: 203.0.113.42 (Unknown location)<br>Time: 2:34 AM EST</p>
              <div class="mt-3 flex space-x-2">
                <button class="px-3 py-1 bg-red-600 hover:bg-red-700 text-white rounded text-xs">Block User</button>
                <button class="px-3 py-1 bg-slate-600 hover:bg-slate-700 text-white rounded text-xs">Investigate</button>
              </div>
            </div>

            <!-- Approval Request -->
            <div class="bg-blue-900/20 border border-blue-700/50 rounded-lg p-4">
              <div class="flex items-center mb-2">
                <div class="w-6 h-6 bg-blue-600 rounded flex items-center justify-center mr-2">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <span class="font-medium text-blue-300">Approval Required</span>
              </div>
              <p class="text-sm text-slate-300 mb-2">📋 **Access request pending approval**</p>
              <p class="text-sm text-slate-400">User: jane.smith@company.com<br>Resource: Marketing Database<br>Role: Read-only access</p>
              <div class="mt-3 flex space-x-2">
                <button class="px-3 py-1 bg-green-600 hover:bg-green-700 text-white rounded text-xs">Approve</button>
                <button class="px-3 py-1 bg-red-600 hover:bg-red-700 text-white rounded text-xs">Deny</button>
              </div>
            </div>

            <!-- System Status -->
            <div class="bg-green-900/20 border border-green-700/50 rounded-lg p-4">
              <div class="flex items-center mb-2">
                <div class="w-6 h-6 bg-green-600 rounded flex items-center justify-center mr-2">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <span class="font-medium text-green-300">Backup Complete</span>
              </div>
              <p class="text-sm text-slate-300 mb-2">✅ **Daily backup completed successfully**</p>
              <p class="text-sm text-slate-400">Size: 2.3 GB<br>Duration: 15 minutes<br>Next backup: Tonight 1:00 AM</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Installation Info -->
      <div class="space-y-6">
        <!-- Installation Status -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <h3 class="text-lg font-semibold mb-4">Installation</h3>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-300">Status</span>
              <span class="px-2 py-1 bg-yellow-600/20 text-yellow-300 rounded text-xs">Not Installed</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-300">Price</span>
              <span class="text-sm text-green-300">Free</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-300">Permissions</span>
              <span class="text-xs text-slate-400">Read channels, Post messages</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-300">Version</span>
              <span class="text-xs text-slate-400">2.1.4</span>
            </div>
          </div>
        </div>

        <!-- Requirements -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <h3 class="text-lg font-semibold mb-4">Requirements</h3>
          <div class="space-y-2 text-sm">
            <div class="flex items-center">
              <svg class="w-4 h-4 text-green-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Slack workspace admin</span>
            </div>
            <div class="flex items-center">
              <svg class="w-4 h-4 text-green-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>AtlasIT Professional plan</span>
            </div>
            <div class="flex items-center">
              <svg class="w-4 h-4 text-green-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Slack Enterprise Grid (optional)</span>
            </div>
          </div>
        </div>

        <!-- Support -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <h3 class="text-lg font-semibold mb-4">Support & Help</h3>
          <div class="space-y-2">
            <a href="#" class="block w-full px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors text-sm text-center">
              View Documentation
            </a>
            <a href="#" class="block w-full px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors text-sm text-center">
              Contact Support
            </a>
            <a href="#" class="block w-full px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors text-sm text-center">
              Report Issues
            </a>
          </div>
        </div>

        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <h3 class="text-lg font-semibold mb-4">Simulation Run History</h3>
          <div class="space-y-3 text-sm">
            <div class="simulated-history__item">
              <div>
                <p class="simulated-history__title">2025-09-16 · Access Approval Workflow</p>
                <p class="simulated-history__meta">Slack notifications and approvals executed in simulated mode</p>
              </div>
              <span class="badge-simulated">Simulated</span>
            </div>
            <div class="simulated-history__item">
              <div>
                <p class="simulated-history__title">2025-09-13 · Offboarding Alerts</p>
                <p class="simulated-history__meta">Sandbox channel updates for departing users</p>
              </div>
              <span class="badge-simulated">Simulated</span>
            </div>
          </div>
        </div>

        <!-- Related Integrations -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <h3 class="text-lg font-semibold mb-4">Related Integrations</h3>
          <div class="space-y-3">
            <div class="flex items-center p-2 bg-slate-800/30 rounded-lg">
              <div class="w-8 h-8 bg-blue-600 rounded mr-3 flex items-center justify-center">
                <span class="text-white text-xs font-bold">MS</span>
              </div>
              <div>
                <div class="text-sm font-medium">Microsoft Teams</div>
                <div class="text-xs text-slate-400">Communication</div>
              </div>
            </div>
            <div class="flex items-center p-2 bg-slate-800/30 rounded-lg">
              <div class="w-8 h-8 bg-purple-600 rounded mr-3 flex items-center justify-center">
                <span class="text-white text-xs font-bold">D</span>
              </div>
              <div>
                <div class="text-sm font-medium">Discord</div>
                <div class="text-xs text-slate-400">Team Chat</div>
              </div>
            </div>
            <div class="flex items-center p-2 bg-slate-800/30 rounded-lg">
              <div class="w-8 h-8 bg-orange-600 rounded mr-3 flex items-center justify-center">
                <span class="text-white text-xs font-bold">Z</span>
              </div>
