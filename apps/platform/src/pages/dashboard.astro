            <div class="text-right">
              <span class="text-xs uppercase tracking-wide text-slate-500">Pending</span>
              <p class="text-2xl font-bold text-amber-300" data-metric="pending-requests">—</p>
            </div>
          </div>
          <ul id="dashboard-demo-requests" class="space-y-4 text-sm"></ul>
          <p id="dashboard-requests-empty" class="hidden text-sm text-slate-400">No pending requests at the moment.</p>
        </div>

        <div class="glass-effect p-6 rounded-xl border border-slate-700/50 overflow-x-auto">
          <div class="flex justify-between items-start mb-4">
            <div>
              <h3 class="text-xl font-semibold text-slate-100">Demo Users</h3>
              <p class="text-slate-400 text-sm">Sample personas with roles, statuses, and recent activity.</p>
            </div>
            <div class="text-right">
              <span class="text-xs uppercase tracking-wide text-slate-500">Active</span>
              <p class="text-2xl font-bold text-blue-300" data-metric="active-users">—</p>
            </div>
          </div>
          <div class="flex flex-col lg:flex-row lg:items-center gap-3 mb-4">
            <select id="dashboard-persona-select" class="w-full lg:w-64 px-3 py-2 bg-slate-900/70 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-blue-500">
              <option value="">Highlight a persona</option>
            </select>
            <button id="dashboard-clear-persona" class="px-3 py-2 text-xs uppercase tracking-wide rounded-lg border border-slate-600 text-slate-300 hover:bg-slate-800 transition-colors">Clear</button>
          </div>
          <div id="dashboard-persona-preview" class="hidden border border-slate-700/60 bg-slate-900/70 rounded-lg p-4 mb-4 text-sm text-slate-200">
            <div class="flex justify-between items-start mb-2">
              <div>
                <p id="dashboard-preview-name" class="font-semibold">—</p>
                <p id="dashboard-preview-role" class="text-slate-400 text-xs">—</p>
              </div>
              <span id="dashboard-preview-status" class="text-xs px-2 py-1 rounded-full bg-slate-600/40">—</span>
            </div>
            <dl class="grid grid-cols-2 gap-3 text-xs text-slate-300">
              <div>
                <dt class="text-slate-500">Last Active</dt>
                <dd id="dashboard-preview-last-active">—</dd>
              </div>
              <div>
                <dt class="text-slate-500">Risk Level</dt>
                <dd id="dashboard-preview-risk">—</dd>
              </div>
              <div class="col-span-2">
                <dt class="text-slate-500">Persona Focus</dt>
                <dd id="dashboard-preview-persona" class="mt-1">—</dd>
              </div>
            </dl>
          </div>
          <table class="min-w-full text-left text-sm">
            <thead class="text-slate-400 uppercase tracking-wide text-xs">
              <tr>
                <th class="py-2">User</th>
                <th class="py-2">Role</th>
                <th class="py-2">Status</th>
                <th class="py-2">Last Active</th>
              </tr>
            </thead>
            <tbody id="dashboard-demo-users" class="divide-y divide-slate-700"></tbody>
          </table>
        </div>
      </section>

      <!-- Recent Activity -->
      <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
        <h2 class="text-2xl font-semibold mb-6 text-slate-100">Recent Activity</h2>
        <div id="dashboard-activity" class="space-y-4"></div>
        <p id="dashboard-activity-empty" class="hidden text-sm text-slate-400">No recent activity yet. Trigger onboarding actions to populate the feed.</p>
      </div>
    </main>

    <!-- Footer -->
    <footer class="glass-effect border-t border-slate-700/50 mt-16">
      <div class="container mx-auto px-6 py-8">
        <div class="flex flex-col md:flex-row justify-between items-center">
          <div class="flex items-center space-x-2 mb-4 md:mb-0">
            <div class="w-6 h-6 bg-gradient-to-r from-blue-500 to-purple-600 rounded flex items-center justify-center">
              <span class="text-white font-bold text-xs">AI</span>
            </div>
            <span class="text-slate-400">© 2025 AtlasIT. Enterprise IT Automation Platform.</span>
          </div>
          <div class="flex space-x-6 text-sm text-slate-400">
            <a href="#" class="hover:text-slate-300 transition-colors">Privacy</a>
            <a href="#" class="hover:text-slate-300 transition-colors">Terms</a>
            <a href="#" class="hover:text-slate-300 transition-colors">Support</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      mobileMenuBtn?.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });

      // Close mobile menu when clicking outside
      document.addEventListener('click', (e) => {
        if (!mobileMenuBtn?.contains(e.target) && !mobileMenu?.contains(e.target)) {
          mobileMenu?.classList.add('hidden');
        }
      });

      // User info handling
      const user = localStorage.getItem('atlasit_user');
      if (!user) {
        window.location.href = '/login';
      } else {
        const userData = JSON.parse(user);
        const userInfoDiv = document.getElementById('user-info');
        if (userInfoDiv) {
          userInfoDiv.innerHTML = '<div class="flex justify-between items-center"><span>Welcome, ' + (userData.company || userData.email) + '!</span><button onclick="logout()" class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700">Logout</button></div>';
        }
      }

      function logout() {
        localStorage.removeItem('atlasit_user');
        window.location.href = '/login';
      }

      function formatDateTime(isoString) {
        try {
          return new Intl.DateTimeFormat('en-US', {
            dateStyle: 'medium',
            timeStyle: 'short'
          }).format(new Date(isoString));
        } catch (error) {
          return isoString;
        }
      }

      const personaSelect = document.getElementById('dashboard-persona-select');
      const clearPersonaBtn = document.getElementById('dashboard-clear-persona');
      const personaPreview = document.getElementById('dashboard-persona-preview');
      const previewName = document.getElementById('dashboard-preview-name');
      const previewRole = document.getElementById('dashboard-preview-role');
      const previewStatus = document.getElementById('dashboard-preview-status');
      const previewLastActive = document.getElementById('dashboard-preview-last-active');
      const previewRisk = document.getElementById('dashboard-preview-risk');
      const previewPersona = document.getElementById('dashboard-preview-persona');

      let selectedPersonaId = '';
      let dashboardUsers = [];

      const resetButton = document.getElementById('dashboard-reset-btn');
      const resetStatus = document.getElementById('dashboard-reset-status');
      const loadingIndicator = document.getElementById('dashboard-loading');
      const requestsEmptyState = document.getElementById('dashboard-requests-empty');
      const activityEmptyState = document.getElementById('dashboard-activity-empty');
      const iamUsersLoading = document.getElementById('iam-users-loading');
      const iamUsersError = document.getElementById('iam-users-error');
      const iamUsersTable = document.getElementById('iam-users-table');
      const iamUsersBody = document.getElementById('iam-users-body');
      const iamUsersPill = document.getElementById('iam-users-pill');
      const iamWorkflowsLoading = document.getElementById('iam-workflows-loading');
      const iamWorkflowsError = document.getElementById('iam-workflows-error');
      const iamWorkflowsEmpty = document.getElementById('iam-workflows-empty');
      const iamWorkflowsList = document.getElementById('iam-workflows-list');
      const iamWorkflowsPill = document.getElementById('iam-workflows-pill');
      const iamIntegrationsLoading = document.getElementById('iam-integrations-loading');
      const iamIntegrationsError = document.getElementById('iam-integrations-error');
      const iamIntegrationsList = document.getElementById('iam-integrations-list');
      const iamIntegrationsPill = document.getElementById('iam-integrations-pill');

      function applyMetric(name, value) {
        document.querySelectorAll('[data-metric="' + name + '"]').forEach((el) => {
          el.textContent = value;
        });
      }

      function show(el, visible) {
        if (!el) return;
        el.classList.toggle('hidden', !visible);
      }

      function renderIamUsers(users) {
        if (!iamUsersBody || !iamUsersTable) return;
        iamUsersBody.innerHTML = '';
        users.forEach((user) => {
          const row = document.createElement('tr');
          row.innerHTML = `
            <td class="py-2">
              <div class="font-medium text-slate-200">${user.name}</div>
              <div class="text-slate-400 text-xs">${user.email}</div>
            </td>
            <td class="py-2 text-slate-300">${user.title}</td>
            <td class="py-2 text-slate-300">${(user.systems || []).map((s) => s.toUpperCase()).join(', ')}</td>
          `;
          iamUsersBody.appendChild(row);
        });
        show(iamUsersTable, users.length > 0);
        if (iamUsersPill) {
          iamUsersPill.textContent = `${users.length} users`;
        }
      }

      function renderIamIntegrations(integrations) {
        if (!iamIntegrationsList) return;
        iamIntegrationsList.innerHTML = '';
        integrations.forEach((integration) => {
          const item = document.createElement('li');
          item.className = 'border border-slate-700/60 rounded-lg p-3 bg-slate-900/40';
          item.innerHTML = `
            <div class="flex justify-between items-start">
              <div>
                <p class="text-slate-100 font-medium">${integration.name}</p>
                <p class="text-slate-400 text-xs mb-2">${integration.description}</p>
              </div>
              <span class="text-[0.65rem] px-2 py-1 rounded-full bg-slate-700/70 text-slate-200 uppercase tracking-wide">${integration.oktaGroup}</span>
            </div>
            <p class="text-xs text-slate-400">Mechanism: ${integration.mechanism}</p>
          `;
          iamIntegrationsList.appendChild(item);
        });
        show(iamIntegrationsList, integrations.length > 0);
        if (iamIntegrationsPill) {
          iamIntegrationsPill.textContent = `${integrations.length} integrations`;
        }
      }

      function renderIamWorkflows(workflows) {
        if (!iamWorkflowsList) return;
        iamWorkflowsList.innerHTML = '';
        workflows.forEach((workflow) => {
          const item = document.createElement('li');
          item.className = 'border border-slate-700/60 rounded-lg p-3 bg-slate-900/40';
          const steps = (workflow.steps || []).map((step) => `
              <div class="flex justify-between text-xs text-slate-300">
                <span class="uppercase tracking-wide">${step.system}</span>
                <span class="px-2 py-0.5 rounded-full ${step.state === 'completed' ? 'bg-green-500/20 text-green-300' : step.state === 'provisioning' ? 'bg-blue-500/20 text-blue-200' : step.state === 'error' ? 'bg-red-500/20 text-red-300' : 'bg-slate-600/30 text-slate-300'}">${step.state}</span>
              </div>
            `).join('');
          item.innerHTML = `
            <div class="flex justify-between items-start mb-2">
              <div>
                <p class="text-slate-100 font-medium">${workflow.userId}</p>
                <p class="text-slate-400 text-xs">Submitted ${formatDateTime(workflow.submittedAt)}</p>
              </div>
              <span class="text-xs px-2 py-1 rounded-full ${workflow.status === 'completed' ? 'bg-green-500/20 text-green-300' : workflow.status === 'failed' ? 'bg-red-500/20 text-red-300' : 'bg-blue-500/20 text-blue-200'}">${workflow.status}</span>
            </div>
            <div class="space-y-1">${steps}</div>
          `;
          iamWorkflowsList.appendChild(item);
        });
        show(iamWorkflowsList, workflows.length > 0);
        show(iamWorkflowsEmpty, workflows.length === 0);
        if (iamWorkflowsPill) {
          iamWorkflowsPill.textContent = `${workflows.length} workflows`;
        }
      }

      function getStatusClass(status) {
        switch (status) {
          case 'Active':
            return 'bg-green-500/20 text-green-300';
          case 'Pending Approval':
            return 'bg-yellow-500/20 text-yellow-300';
          case 'Provisioning':
            return 'bg-blue-500/20 text-blue-300';
          case 'Dormant':
            return 'bg-slate-500/20 text-slate-200';
          default:
            return 'bg-red-500/20 text-red-300';
        }
      }

      function renderDemoUsers(users) {
        const table = document.getElementById('dashboard-demo-users');
        if (!table) return;
        table.innerHTML = '';
        users.forEach((user) => {
          const row = document.createElement('tr');
          const isSelected = selectedPersonaId === user.id;
          row.className = 'transition-colors duration-150' + (isSelected ? ' bg-blue-500/10 border border-blue-500/30' : '');
          row.innerHTML = `
            <td class="py-3">
              <div class="font-medium text-slate-200">${user.name}</div>
              <div class="text-slate-400 text-xs">${user.email}</div>
            </td>
            <td class="py-3 text-slate-300">${user.role}</td>
            <td class="py-3">
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold ${getStatusClass(user.status)}">${user.status}</span>
            </td>
            <td class="py-3 text-slate-300">${formatDateTime(user.lastActive)}</td>
          `;
          table.appendChild(row);
        });
      }

      function renderRequests(requests, users) {
        const list = document.getElementById('dashboard-demo-requests');
        if (!list) return;
        list.innerHTML = '';
        requests.forEach((request) => {
          const user = users.find((entry) => entry.id === request.userId);
          const item = document.createElement('li');
          item.className = 'p-4 bg-slate-900/60 border border-slate-700/40 rounded-lg';
          const approvals = request.approvals
            .map((approval) => `${approval.stage}: ${approval.status === 'approved' ? '✅' : approval.status === 'pending' ? '🕒' : '⛔️'}`)
            .join(' · ');
          item.innerHTML = `
            <div class="flex justify-between items-start">
              <div>
                <p class="text-slate-200 font-medium">${request.title}</p>
                <p class="text-slate-400 text-xs mt-1">${user ? user.name : request.userId} • Submitted ${formatDateTime(request.submittedAt)}</p>
              </div>
              <span class="text-xs px-2 py-1 rounded-full ${request.status === 'completed' ? 'bg-green-500/20 text-green-300' : request.status === 'in-flight' ? 'bg-blue-500/20 text-blue-200' : request.status === 'pending' ? 'bg-yellow-500/20 text-yellow-200' : 'bg-red-500/20 text-red-200'}">${request.status}</span>
            </div>
            <p class="text-slate-300 text-sm mt-3">Targets: ${request.targetApps.join(', ')}</p>
            <p class="text-slate-500 text-xs mt-2">Approvals: ${approvals}</p>
          `;
          list.appendChild(item);
        });
        if (requestsEmptyState) {
          requestsEmptyState.classList.toggle('hidden', requests.length > 0);
        }
      }

      function renderActivity(activity) {
        const container = document.getElementById('dashboard-activity');
        if (!container) return;
        container.innerHTML = '';
        activity.forEach((entry) => {
          const wrapper = document.createElement('div');
          const colorClasses = entry.type === 'security'
            ? { bg: 'bg-green-500/20', icon: 'text-green-400' }
            : entry.type === 'automation'
            ? { bg: 'bg-purple-500/20', icon: 'text-purple-400' }
            : entry.type === 'compliance'
            ? { bg: 'bg-yellow-500/20', icon: 'text-yellow-400' }
            : { bg: 'bg-blue-500/20', icon: 'text-blue-400' };
          wrapper.className = 'flex items-center space-x-4 p-4 bg-slate-800/50 rounded-lg';
          wrapper.innerHTML = `
            <div class="w-10 h-10 ${colorClasses.bg} rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 ${colorClasses.icon}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-slate-100 font-medium">${entry.title}</p>
              <p class="text-slate-400 text-sm">${entry.description}</p>
            </div>
            <span class="text-slate-500 text-sm">${entry.relativeTime}</span>
          `;
          container.appendChild(wrapper);
        });
        if (activityEmptyState) {
          activityEmptyState.classList.toggle('hidden', activity.length > 0);
        }
      }

      function updatePersonaPreview(user) {
        if (!personaPreview) return;
        personaPreview.classList.remove('hidden');
        if (previewName) previewName.textContent = `${user.name} — ${user.company}`;
        if (previewRole) previewRole.textContent = `${user.role} • ${user.department}`;
        if (previewStatus) {
          previewStatus.textContent = `${user.status}`;
          previewStatus.className = `text-xs px-2 py-1 rounded-full ${getStatusClass(user.status)}`;
        }
        if (previewLastActive) previewLastActive.textContent = formatDateTime(user.lastActive);
        if (previewRisk) previewRisk.textContent = user.riskLevel;
        if (previewPersona) previewPersona.textContent = `${user.persona} — Managed by ${user.manager} (${user.location})`;
      }

      function clearPersonaPreview() {
        if (!personaPreview) return;
        personaPreview.classList.add('hidden');
        if (previewName) previewName.textContent = '—';
        if (previewRole) previewRole.textContent = '—';
        if (previewStatus) {
          previewStatus.textContent = '—';
          previewStatus.className = 'text-xs px-2 py-1 rounded-full bg-slate-600/40';
        }
        if (previewLastActive) previewLastActive.textContent = '—';
        if (previewRisk) previewRisk.textContent = '—';
        if (previewPersona) previewPersona.textContent = '—';
      }

      async function hydrateIam() {
        if (iamUsersLoading) iamUsersLoading.textContent = 'Loading directory users…';
        show(iamUsersLoading, true);
        show(iamUsersError, false);
        show(iamIntegrationsLoading, true);
        show(iamIntegrationsError, false);
        show(iamWorkflowsLoading, true);
        show(iamWorkflowsError, false);
        show(iamWorkflowsEmpty, false);
        show(iamWorkflowsList, false);
        show(iamIntegrationsList, false);
        show(iamUsersTable, false);

        try {
          const [usersRes, workflowsRes, integrationsRes] = await Promise.all([
            fetch('/api/iam-automation?type=users'),
            fetch('/api/iam-automation?type=workflows'),
            fetch('/api/iam-automation?type=integrations'),
          ]);

          if (!usersRes.ok) throw new Error('Failed to load users');
          if (!workflowsRes.ok) throw new Error('Failed to load workflows');
          if (!integrationsRes.ok) throw new Error('Failed to load integrations');

          const [users, workflows, integrations] = await Promise.all([
            usersRes.json(),
            workflowsRes.json(),
            integrationsRes.json(),
          ]);

          renderIamUsers(users || []);
          renderIamWorkflows(workflows || []);
          renderIamIntegrations(integrations || []);
        } catch (error) {
          console.warn('[dashboard] Unable to hydrate IAM data', error);
          show(iamUsersError, true);
          show(iamWorkflowsError, true);
          show(iamIntegrationsError, true);
        } finally {
          show(iamUsersLoading, false);
          show(iamIntegrationsLoading, false);
          show(iamWorkflowsLoading, false);
        }
      }

      async function hydrateDashboard() {
        try {
          loadingIndicator?.classList.remove('hidden');
          const response = await fetch('/api/demo/data');
          if (!response.ok) {
            throw new Error('Failed to load demo metrics');
          }
          const payload = await response.json();
          const data = payload?.data || {};
          const metrics = data.metrics || {};
          const users = data.users || [];
          const requests = data.requests || [];
          const activity = data.activity || [];

          applyMetric('active-users', metrics.activeUsers ?? '—');
          applyMetric('pending-requests', metrics.pendingRequests ?? '—');
          applyMetric('connected-systems', metrics.connectedSystems ?? '—');
          applyMetric('security-score', metrics.securityScore != null ? metrics.securityScore + '%' : '—');
          applyMetric('active-workflows', metrics.activeWorkflows ?? '—');
          applyMetric('automation-coverage', metrics.automationCoverage != null ? metrics.automationCoverage + '%' : '—');
          applyMetric('avg-provisioning', metrics.avgProvisioningTimeMinutes != null ? metrics.avgProvisioningTimeMinutes + ' min' : '—');

          dashboardUsers = users;
          selectedPersonaId = '';
          clearPersonaPreview();
          if (personaSelect) personaSelect.value = '';
          if (personaSelect) {
            personaSelect.innerHTML = '<option value="">Highlight a persona</option>';
            dashboardUsers.forEach((user) => {
              const option = document.createElement('option');
              option.value = user.id;
              option.textContent = `${user.name} • ${user.role} (${user.status})`;
              personaSelect.appendChild(option);
            });
          }

          renderDemoUsers(users);
          renderRequests(requests, users);
          renderActivity(activity);
          await hydrateIam();
        } catch (error) {
          console.warn('[dashboard] Unable to hydrate demo data', error);
          if (resetStatus) {
            resetStatus.textContent = 'Failed to load demo data. Try refreshing the page.';
            resetStatus.classList.remove('hidden');
            resetStatus.classList.add('text-yellow-200');
          }
        }
        loadingIndicator?.classList.add('hidden');
      }

      hydrateDashboard();

      personaSelect?.addEventListener('change', (event) => {
        const selectedId = event.target.value;
        selectedPersonaId = selectedId;
        if (!selectedId) {
          clearPersonaPreview();
          renderDemoUsers(dashboardUsers);
          return;
        }
        const user = dashboardUsers.find((entry) => entry.id === selectedId);
        if (!user) {
          clearPersonaPreview();
          renderDemoUsers(dashboardUsers);
          return;
        }
        updatePersonaPreview(user);
        renderDemoUsers(dashboardUsers);
      });

      clearPersonaBtn?.addEventListener('click', () => {
        selectedPersonaId = '';
        if (personaSelect) personaSelect.value = '';
        clearPersonaPreview();
        renderDemoUsers(dashboardUsers);
      });

      resetButton?.addEventListener('click', async () => {
        if (!confirm('Reset demo data to the default personas and metrics?')) {
          return;
        }

        try {
          resetButton.setAttribute('disabled', 'true');
          resetButton.textContent = 'Resetting…';
          resetStatus?.classList.add('hidden');

          const response = await fetch('/api/demo/reset', { method: 'POST' });
          if (!response.ok) {
            const payload = await response.json().catch(() => ({}));
            throw new Error(payload?.error || 'Failed to reset demo');
          }

          const iamResetResponse = await fetch('/api/iam-automation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'reset' }),
          });
          if (!iamResetResponse.ok) {
            const payload = await iamResetResponse.json().catch(() => ({}));
            throw new Error(payload?.error || 'Failed to reset IAM data');
          }

          await hydrateDashboard();

          if (resetStatus) {
            resetStatus.textContent = 'Demo reset complete.';
            resetStatus.classList.remove('text-yellow-200');
            resetStatus.classList.add('text-green-300');
            resetStatus.classList.remove('hidden');
          }
        } catch (error) {
          const message = error instanceof Error ? error.message : String(error);
          alert(`Reset failed: ${message}`);
        } finally {
          if (resetButton) {
            resetButton.removeAttribute('disabled');
            resetButton.textContent = 'Reset Demo Data';
          }
        }
      });
    </script>
  </body>
</html>
