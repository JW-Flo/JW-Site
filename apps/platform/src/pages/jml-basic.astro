            <input type="checkbox" id="app-${app.replace(/\s+/g, '-').toLowerCase()}" value="${app}" checked onchange="updateEmployeePreview()">
            <label for="app-${app.replace(/\s+/g, '-').toLowerCase()}">${app}</label>
          </div>
        `;
        applicationsContainer.innerHTML += checkboxHTML;
      });

      // Add common enterprise applications
