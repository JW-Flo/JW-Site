---
title: "Enhanced Security Scanner"
---

<html lang="en">
  <head>
    <title>Enhanced Security Scanner | AtlasIT</title>
  </head>
  <body class="bg-gray-900 text-white min-h-screen">
    <div class="container mx-auto px-4 py-8">
      <div class="mb-8">
        <h1 class="text-4xl font-bold mb-4">Enhanced Security Scanner</h1>
        <p class="text-lg text-gray-300 mb-6">Comprehensive security analysis and vulnerability assessment for your IT infrastructure</p>
        <div class="flex gap-4">
          <button class="bg-red-600 hover:bg-red-700 px-6 py-3 rounded-lg font-semibold transition-colors">
            Start Full Scan
          </button>
          <button class="bg-gray-700 hover:bg-gray-600 px-6 py-3 rounded-lg font-semibold transition-colors">
            Quick Scan
          </button>
          <button class="bg-gray-700 hover:bg-gray-600 px-6 py-3 rounded-lg font-semibold transition-colors">
            Scheduled Scans
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <div class="bg-gray-800 p-6 rounded-lg border border-gray-700">
          <h3 class="text-xl font-semibold mb-4">Scan Status</h3>
          <div class="space-y-3">
            <div class="flex justify-between">
              <span>Last Full Scan:</span>
              <span class="text-green-400">2 hours ago</span>
            </div>
            <div class="flex justify-between">
              <span>Critical Issues:</span>
              <span class="text-red-400">3</span>
            </div>
            <div class="flex justify-between">
              <span>High Priority:</span>
              <span class="text-orange-400">7</span>
            </div>
            <div class="flex justify-between">
              <span>Medium Priority:</span>
              <span class="text-yellow-400">12</span>
            </div>
          </div>
        </div>

        <div class="bg-gray-800 p-6 rounded-lg border border-gray-700">
          <h3 class="text-xl font-semibold mb-4">Security Score</h3>
          <div class="text-center">
            <div class="text-5xl font-bold text-green-400 mb-2">87%</div>
            <div class="text-sm text-gray-400">Overall Security Rating</div>
            <div class="mt-4 bg-gray-700 rounded-full h-3">
              <div class="bg-green-400 h-3 rounded-full" style="width: 87%"></div>
            </div>
          </div>
        </div>

        <div class="bg-gray-800 p-6 rounded-lg border border-gray-700">
          <h3 class="text-xl font-semibold mb-4">Active Threats</h3>
          <div class="space-y-2">
            <div class="flex items-center justify-between p-2 bg-red-900/20 rounded">
              <span class="text-sm">Outdated SSL Certificate</span>
              <span class="text-red-400 text-xs">Critical</span>
            </div>
            <div class="flex items-center justify-between p-2 bg-orange-900/20 rounded">
              <span class="text-sm">Weak Password Policy</span>
              <span class="text-orange-400 text-xs">High</span>
            </div>
            <div class="flex items-center justify-between p-2 bg-yellow-900/20 rounded">
              <span class="text-sm">Unpatched Software</span>
              <span class="text-yellow-400 text-xs">Medium</span>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <div class="bg-gray-800 p-6 rounded-lg border border-gray-700">
          <h3 class="text-xl font-semibold mb-4">Vulnerability Assessment</h3>
          <div class="space-y-4">
            <div class="border-l-4 border-red-500 pl-4">
              <h4 class="font-medium">CVE-2024-1234 - Remote Code Execution</h4>
              <p class="text-sm text-gray-400">Critical vulnerability in web server</p>
              <div class="mt-2">
                <span class="text-xs bg-red-900/50 px-2 py-1 rounded">CVSS: 9.8</span>
                <span class="text-xs bg-gray-700 px-2 py-1 rounded ml-2">Affected: 3 systems</span>
              </div>
            </div>
            <div class="border-l-4 border-orange-500 pl-4">
              <h4 class="font-medium">Weak Authentication</h4>
              <p class="text-sm text-gray-400">Password requirements not enforced</p>
              <div class="mt-2">
                <span class="text-xs bg-orange-900/50 px-2 py-1 rounded">Risk: High</span>
                <span class="text-xs bg-gray-700 px-2 py-1 rounded ml-2">Affected: 15 users</span>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-gray-800 p-6 rounded-lg border border-gray-700">
          <h3 class="text-xl font-semibold mb-4">Compliance Check</h3>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span>GDPR Compliance</span>
              <span class="text-green-400">✓ Compliant</span>
            </div>
            <div class="flex items-center justify-between">
              <span>HIPAA Compliance</span>
              <span class="text-yellow-400">⚠ Review Required</span>
            </div>
            <div class="flex items-center justify-between">
              <span>ISO 27001</span>
              <span class="text-green-400">✓ Compliant</span>
            </div>
            <div class="flex items-center justify-between">
              <span>PCI DSS</span>
              <span class="text-red-400">✗ Non-compliant</span>
            </div>
            <div class="flex items-center justify-between">
              <span>SOX Compliance</span>
              <span class="text-green-400">✓ Compliant</span>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-gray-800 p-6 rounded-lg">
        <h2 class="text-2xl font-semibold mb-4">Scan History</h2>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-gray-700">
                <th class="text-left py-2">Scan Type</th>
                <th class="text-left py-2">Date</th>
                <th class="text-left py-2">Duration</th>
                <th class="text-left py-2">Issues Found</th>
                <th class="text-left py-2">Status</th>
              </tr>
            </thead>
            <tbody class="text-sm">
              <tr class="border-b border-gray-700">
                <td class="py-2">Full Security Scan</td>
                <td class="py-2">2025-09-04 14:30</td>
                <td class="py-2">45 min</td>
                <td class="py-2">22 issues</td>
                <td class="py-2 text-green-400">Completed</td>
              </tr>
              <tr class="border-b border-gray-700">
                <td class="py-2">Quick Vulnerability Check</td>
                <td class="py-2">2025-09-04 12:00</td>
                <td class="py-2">8 min</td>
                <td class="py-2">5 issues</td>
                <td class="py-2 text-green-400">Completed</td>
              </tr>
              <tr class="border-b border-gray-700">
                <td class="py-2">Compliance Audit</td>
                <td class="py-2">2025-09-04 09:15</td>
                <td class="py-2">120 min</td>
                <td class="py-2">3 issues</td>
                <td class="py-2 text-yellow-400">Warning</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </body>
</html>
