---
const title = "Multi-Factor Authentication - AtlasIT Security";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  
  <style>
    .nav-link { transition: all 0.2s ease; }
    .nav-link:hover { transform: translateY(-1px); }
    .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    .glass-effect { backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.1); }
    .input-field { transition: all 0.2s ease; }
    .input-field:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
    .demo-banner { background: linear-gradient(90deg, rgba(37,99,235,0.25), rgba(168,85,247,0.25)); border: 1px solid rgba(59,130,246,0.35); border-radius: 0.75rem; color: #bfdbfe; font-size: 0.75rem; letter-spacing: 0.08em; padding: 0.6rem 1rem; text-transform: uppercase; text-align: center; margin: 1.5rem auto 0; max-width: 60rem; }
    .device-card { transition: all 0.2s ease; }
    .device-card:hover { transform: translateY(-2px); }
    .qr-code { 
      background: white; 
      padding: 20px; 
      border-radius: 8px; 
      display: inline-block;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    .setup-step {
      opacity: 0.7;
      transition: all 0.3s ease;
    }
    .setup-step.active {
      opacity: 1;
      transform: translateX(0);
    }
    .setup-step.completed {
      opacity: 0.8;
    }
    .step-indicator {
      background: linear-gradient(135deg, #3b82f6, #8b5cf6);
      width: 2rem;
      height: 2rem;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      font-size: 0.875rem;
    }
    .recovery-code {
      font-family: 'Courier New', monospace;
      background: rgba(30, 41, 59, 0.8);
      padding: 0.5rem;
      border-radius: 0.25rem;
      border: 1px solid #475569;
      text-align: center;
      font-weight: bold;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-slate-100 min-h-screen">
  <!-- Header -->
  <header class="glass-effect border-b border-slate-700/50 sticky top-0 z-50">
    <nav class="container mx-auto px-6 py-4">
      <div class="flex justify-between items-center">
        <div class="flex items-center space-x-2">
          <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-purple-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-sm">AI</span>
          </div>
          <h1 class="text-xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">AtlasIT</h1>
        </div>

        <!-- Breadcrumb Navigation -->
        <div class="hidden md:flex items-center space-x-2 text-sm text-slate-400">
          <a href="/dashboard" class="hover:text-slate-300 transition-colors">Dashboard</a>
          <span>›</span>
          <a href="/security" class="hover:text-slate-300 transition-colors">Security</a>
          <span>›</span>
          <span class="text-slate-100">Multi-Factor Authentication</span>
        </div>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-1">
          <a href="/dashboard" class="nav-link px-4 py-2 rounded-lg hover:bg-slate-700/50 text-slate-300 hover:text-white transition-all duration-200">Dashboard</a>
          <a href="/orchestrator" class="nav-link px-4 py-2 rounded-lg hover:bg-slate-700/50 text-slate-300 hover:text-white transition-all duration-200">Orchestrator</a>
          <a href="/marketplace" class="nav-link px-4 py-2 rounded-lg hover:bg-slate-700/50 text-slate-300 hover:text-white transition-all duration-200">Marketplace</a>

          <!-- Security Dropdown -->
          <div class="relative group">
            <button class="nav-link px-4 py-2 rounded-lg bg-blue-600 text-white transition-all duration-200 flex items-center">
              Security <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="absolute top-full left-0 mt-1 w-48 bg-slate-800 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-slate-700">
              <a href="/security" class="block px-4 py-2 text-slate-300 hover:text-white hover:bg-slate-700/50 rounded-t-lg">Security Center</a>
              <a href="/security/mfa" class="block px-4 py-2 text-white bg-slate-700/50">Multi-Factor Auth</a>
              <a href="/enhanced-security-scanner" class="block px-4 py-2 text-slate-300 hover:text-white hover:bg-slate-700/50 rounded-b-lg">Scanner</a>
            </div>
          </div>

          <div class="w-px h-6 bg-slate-600 mx-2"></div>
          <a href="/login" class="nav-link px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white transition-all duration-200">Login</a>
        </div>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden text-slate-300 hover:text-white p-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 space-y-2 border-t border-slate-700 pt-4">
        <a href="/dashboard" class="block px-4 py-2 text-slate-300 hover:text-white hover:bg-slate-700/50 rounded-lg">Dashboard</a>
        <a href="/security" class="block px-4 py-2 text-slate-300 hover:text-white hover:bg-slate-700/50 rounded-lg">Security Center</a>
        <a href="/security/mfa" class="block px-4 py-2 text-white bg-slate-700/50 rounded-lg">Multi-Factor Auth</a>
        <a href="/enhanced-security-scanner" class="block px-4 py-2 text-slate-300 hover:text-white hover:bg-slate-700/50 rounded-lg">Security Scanner</a>
        <div class="pt-2 border-t border-slate-700 mt-4">
          <a href="/login" class="block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-center mb-2">Login</a>
        </div>
      </div>
    </nav>
  </header>

  <div class="demo-banner">Demo Mode · Sample data resets regularly and is not production</div>

  <!-- Main Content -->
  <main class="container mx-auto px-6 py-8">
    <!-- Header Section -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h1 class="text-3xl font-bold mb-2">Multi-Factor Authentication</h1>
          <p class="text-slate-400">Secure your account with additional authentication methods</p>
        </div>
        <div class="flex items-center space-x-3">
          <button id="backup-codes-btn" class="px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white rounded-lg transition-colors">
            View Backup Codes
          </button>
          <button id="disable-mfa-btn" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors">
            Disable MFA
          </button>
        </div>
      </div>

      <!-- MFA Status -->
      <div class="glass-effect p-6 rounded-xl border border-slate-700/50 mb-8">
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <div class="w-12 h-12 bg-green-600 rounded-xl flex items-center justify-center mr-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold">MFA Status: Enabled</h3>
              <p class="text-slate-400">Your account is protected with multi-factor authentication</p>
            </div>
          </div>
          <div class="text-right">
            <div class="text-sm text-slate-400">Active Devices</div>
            <div class="text-2xl font-bold text-green-400" id="device-count">2</div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column: Device Management -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Registered Devices -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-semibold">Registered Devices</h2>
            <button id="add-device-btn" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors text-sm">
              Add New Device
            </button>
          </div>

          <div class="space-y-4" id="devices-list">
            <!-- Device 1: Authenticator App -->
            <div class="device-card bg-slate-800/30 rounded-lg p-4 border border-slate-600/50">
              <div class="flex items-center justify-between">
                <div class="flex items-center">
                  <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center mr-4">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-medium">Google Authenticator</h3>
                    <p class="text-sm text-slate-400">iPhone • Added 3 days ago</p>
                    <p class="text-xs text-green-400 mt-1">● Active</p>
                  </div>
                </div>
                <div class="flex items-center space-x-2">
                  <button class="px-3 py-1 bg-slate-700 hover:bg-slate-600 text-white rounded text-sm transition-colors">
                    Test
                  </button>
                  <button class="px-3 py-1 bg-red-600 hover:bg-red-700 text-white rounded text-sm transition-colors" onclick="removeDevice('auth-app-1')">
                    Remove
                  </button>
                </div>
              </div>
            </div>

            <!-- Device 2: Hardware Key -->
            <div class="device-card bg-slate-800/30 rounded-lg p-4 border border-slate-600/50">
              <div class="flex items-center justify-between">
                <div class="flex items-center">
                  <div class="w-10 h-10 bg-purple-600 rounded-lg flex items-center justify-center mr-4">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-medium">YubiKey 5 NFC</h3>
                    <p class="text-sm text-slate-400">Hardware Security Key • Added 1 week ago</p>
                    <p class="text-xs text-green-400 mt-1">● Active</p>
                  </div>
                </div>
                <div class="flex items-center space-x-2">
                  <button class="px-3 py-1 bg-slate-700 hover:bg-slate-600 text-white rounded text-sm transition-colors">
                    Test
                  </button>
                  <button class="px-3 py-1 bg-red-600 hover:bg-red-700 text-white rounded text-sm transition-colors" onclick="removeDevice('hardware-key-1')">
                    Remove
                  </button>
                </div>
              </div>
            </div>

            <!-- Add New Device Placeholder -->
            <div class="device-card bg-slate-800/20 rounded-lg p-4 border border-dashed border-slate-600 hidden" id="add-device-placeholder">
              <div class="flex items-center justify-center text-center py-4">
                <div>
                  <div class="w-12 h-12 bg-slate-700 rounded-lg flex items-center justify-center mx-auto mb-3">
                    <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                  </div>
                  <p class="text-slate-400 text-sm">Click "Add New Device" to set up additional authentication</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- MFA Setup Wizard (Initially Hidden) -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50 hidden" id="setup-wizard">
          <h2 class="text-xl font-semibold mb-6">Add New Authentication Device</h2>

          <!-- Setup Steps -->
          <div class="space-y-6">
            <!-- Step 1: Choose Method -->
            <div class="setup-step active" id="step-1">
              <div class="flex items-center mb-4">
                <div class="step-indicator mr-4">1</div>
                <h3 class="text-lg font-medium">Choose Authentication Method</h3>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 ml-12">
                <div class="method-option border border-slate-600 rounded-lg p-4 cursor-pointer hover:border-blue-500 transition-colors" data-method="app">
                  <div class="text-center">
                    <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mx-auto mb-3">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                      </svg>
                    </div>
                    <h4 class="font-medium mb-2">Authenticator App</h4>
                    <p class="text-sm text-slate-400">Use Google Authenticator, Authy, or similar apps</p>
                  </div>
                </div>

                <div class="method-option border border-slate-600 rounded-lg p-4 cursor-pointer hover:border-blue-500 transition-colors" data-method="sms">
                  <div class="text-center">
                    <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center mx-auto mb-3">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                      </svg>
                    </div>
                    <h4 class="font-medium mb-2">SMS Text Message</h4>
                    <p class="text-sm text-slate-400">Receive codes via text message</p>
                  </div>
                </div>

                <div class="method-option border border-slate-600 rounded-lg p-4 cursor-pointer hover:border-blue-500 transition-colors" data-method="hardware">
                  <div class="text-center">
                    <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center mx-auto mb-3">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                      </svg>
                    </div>
                    <h4 class="font-medium mb-2">Hardware Key</h4>
                    <p class="text-sm text-slate-400">Use YubiKey or similar hardware tokens</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Step 2: QR Code Setup (For App Method) -->
            <div class="setup-step hidden" id="step-2-app">
              <div class="flex items-center mb-4">
                <div class="step-indicator mr-4">2</div>
                <h3 class="text-lg font-medium">Scan QR Code</h3>
              </div>
              
              <div class="ml-12">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <div class="text-center">
                    <div class="qr-code mb-4">
                      <svg width="200" height="200" viewBox="0 0 200 200">
                        <!-- QR Code Pattern -->
                        <rect width="200" height="200" fill="white"/>
                        <!-- Large corner squares -->
                        <rect x="10" y="10" width="60" height="60" fill="black"/>
                        <rect x="20" y="20" width="40" height="40" fill="white"/>
                        <rect x="30" y="30" width="20" height="20" fill="black"/>
                        
                        <rect x="130" y="10" width="60" height="60" fill="black"/>
                        <rect x="140" y="20" width="40" height="40" fill="white"/>
                        <rect x="150" y="30" width="20" height="20" fill="black"/>
                        
                        <rect x="10" y="130" width="60" height="60" fill="black"/>
                        <rect x="20" y="140" width="40" height="40" fill="white"/>
                        <rect x="30" y="150" width="20" height="20" fill="black"/>
                        
                        <!-- Data pattern simulation -->
                        <rect x="90" y="90" width="10" height="10" fill="black"/>
                        <rect x="110" y="90" width="10" height="10" fill="black"/>
                        <rect x="90" y="110" width="10" height="10" fill="black"/>
                        <rect x="110" y="110" width="10" height="10" fill="black"/>
                        
                        <!-- Random data points -->
                        <rect x="80" y="40" width="10" height="10" fill="black"/>
                        <rect x="100" y="50" width="10" height="10" fill="black"/>
                        <rect x="120" y="80" width="10" height="10" fill="black"/>
                        <rect x="40" y="80" width="10" height="10" fill="black"/>
                        <rect x="60" y="100" width="10" height="10" fill="black"/>
                        <rect x="140" y="120" width="10" height="10" fill="black"/>
                        <rect x="160" y="140" width="10" height="10" fill="black"/>
                        <rect x="80" y="160" width="10" height="10" fill="black"/>
                        <rect x="100" y="170" width="10" height="10" fill="black"/>
                      </svg>
                    </div>
                    <p class="text-sm text-slate-400">Scan with your authenticator app</p>
                  </div>
                  
                  <div>
                    <h4 class="font-medium mb-3">Manual Setup</h4>
                    <p class="text-sm text-slate-400 mb-2">If you can't scan the QR code, enter this key manually:</p>
                    <div class="bg-slate-800 rounded p-3 mb-4">
                      <code class="text-green-400 text-sm font-mono break-all">JBSWY3DPEHPK3PXP</code>
                    </div>
                    
                    <h4 class="font-medium mb-3">Instructions</h4>
                    <ol class="text-sm text-slate-400 space-y-1">
                      <li>1. Open your authenticator app</li>
                      <li>2. Tap "Add Account" or "+"</li>
                      <li>3. Choose "Scan QR Code"</li>
                      <li>4. Point camera at QR code above</li>
                      <li>5. Enter the verification code below</li>
                    </ol>
                  </div>
                </div>
              </div>
            </div>

            <!-- Step 3: Verification -->
            <div class="setup-step hidden" id="step-3">
              <div class="flex items-center mb-4">
                <div class="step-indicator mr-4">3</div>
                <h3 class="text-lg font-medium">Verify Setup</h3>
              </div>
              
              <div class="ml-12">
                <p class="text-slate-400 mb-4">Enter the 6-digit code from your authenticator app to complete setup:</p>
                <div class="flex space-x-2 mb-4">
                  <input type="text" maxlength="1" class="input-field w-12 h-12 text-center text-xl bg-slate-800/50 border border-slate-600 rounded text-slate-100" id="code-1">
                  <input type="text" maxlength="1" class="input-field w-12 h-12 text-center text-xl bg-slate-800/50 border border-slate-600 rounded text-slate-100" id="code-2">
                  <input type="text" maxlength="1" class="input-field w-12 h-12 text-center text-xl bg-slate-800/50 border border-slate-600 rounded text-slate-100" id="code-3">
                  <span class="flex items-center text-slate-500 mx-2">-</span>
                  <input type="text" maxlength="1" class="input-field w-12 h-12 text-center text-xl bg-slate-800/50 border border-slate-600 rounded text-slate-100" id="code-4">
                  <input type="text" maxlength="1" class="input-field w-12 h-12 text-center text-xl bg-slate-800/50 border border-slate-600 rounded text-slate-100" id="code-5">
                  <input type="text" maxlength="1" class="input-field w-12 h-12 text-center text-xl bg-slate-800/50 border border-slate-600 rounded text-slate-100" id="code-6">
                </div>
                <button id="verify-code-btn" class="px-6 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors">
                  Verify & Complete Setup
                </button>
              </div>
            </div>
          </div>

          <!-- Wizard Navigation -->
          <div class="flex justify-between mt-8 pt-6 border-t border-slate-700">
            <button id="cancel-setup-btn" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors">
              Cancel
            </button>
            <div class="space-x-2">
              <button id="prev-step-btn" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors hidden">
                Previous
              </button>
              <button id="next-step-btn" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors hidden">
                Next
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Security Info & Settings -->
      <div class="space-y-6">
        <!-- Security Overview -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <h3 class="text-lg font-semibold mb-4">Security Overview</h3>
          
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-300">MFA Enabled</span>
              <span class="px-2 py-1 bg-green-600/20 text-green-300 rounded text-xs">Yes</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-300">Active Devices</span>
              <span class="text-sm text-slate-400">2</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-300">Backup Codes</span>
              <span class="text-sm text-yellow-400">8 remaining</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-300">Last Login</span>
              <span class="text-sm text-slate-400">2 hours ago</span>
            </div>
          </div>
        </div>

        <!-- Recovery Options -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50">
          <h3 class="text-lg font-semibold mb-4">Recovery Options</h3>
          
          <div class="space-y-3">
            <div class="bg-slate-800/30 rounded-lg p-3">
              <div class="flex items-center justify-between">
                <div>
                  <div class="font-medium text-sm">Backup Codes</div>
                  <div class="text-xs text-slate-400">8 codes remaining</div>
                </div>
                <button class="text-blue-400 hover:text-blue-300 text-sm" onclick="showBackupCodes()">
                  View
                </button>
              </div>
            </div>
            
