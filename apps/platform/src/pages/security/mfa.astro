  <script>
    // Mobile menu toggle
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    mobileMenuBtn?.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    // Close mobile menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!mobileMenuBtn?.contains(e.target) && !mobileMenu?.contains(e.target)) {
        mobileMenu?.classList.add('hidden');
      }
    });

    // MFA Setup Wizard
    let currentStep = 1;
    let selectedMethod = null;

    // Show/hide setup wizard
    document.getElementById('add-device-btn')?.addEventListener('click', () => {
      document.getElementById('setup-wizard').classList.remove('hidden');
      document.getElementById('add-device-placeholder').classList.add('hidden');
      resetSetupWizard();
    });

    document.getElementById('cancel-setup-btn')?.addEventListener('click', () => {
      document.getElementById('setup-wizard').classList.add('hidden');
      document.getElementById('add-device-placeholder').classList.remove('hidden');
      resetSetupWizard();
    });

    // Reset wizard to initial state
    function resetSetupWizard() {
      currentStep = 1;
      selectedMethod = null;
      showStep(1);
      updateWizardButtons();
      
      // Reset method selection
      document.querySelectorAll('.method-option').forEach(option => {
        option.classList.remove('border-blue-500', 'bg-blue-900/20');
        option.classList.add('border-slate-600');
      });
    }

    // Method selection
    document.querySelectorAll('.method-option').forEach(option => {
      option.addEventListener('click', () => {
        // Clear previous selections
        document.querySelectorAll('.method-option').forEach(opt => {
          opt.classList.remove('border-blue-500', 'bg-blue-900/20');
          opt.classList.add('border-slate-600');
        });
        
        // Select current option
        option.classList.remove('border-slate-600');
        option.classList.add('border-blue-500', 'bg-blue-900/20');
        
        selectedMethod = option.dataset.method;
        updateWizardButtons();
      });
    });

    // Show specific setup step
    function showStep(step) {
      // Hide all steps
      document.querySelectorAll('.setup-step').forEach(stepEl => {
        stepEl.classList.add('hidden');
        stepEl.classList.remove('active');
      });
      
      // Show current step
      if (step === 1) {
        document.getElementById('step-1').classList.remove('hidden');
        document.getElementById('step-1').classList.add('active');
      } else if (step === 2 && selectedMethod === 'app') {
        document.getElementById('step-2-app').classList.remove('hidden');
        document.getElementById('step-2-app').classList.add('active');
      } else if (step === 3 || (step === 2 && selectedMethod !== 'app')) {
        document.getElementById('step-3').classList.remove('hidden');
        document.getElementById('step-3').classList.add('active');
      }
      
      currentStep = step;
      updateWizardButtons();
    }

    // Update wizard navigation buttons
    function updateWizardButtons() {
      const prevBtn = document.getElementById('prev-step-btn');
      const nextBtn = document.getElementById('next-step-btn');
      
      // Show/hide previous button
      if (currentStep > 1) {
        prevBtn.classList.remove('hidden');
      } else {
        prevBtn.classList.add('hidden');
      }
      
      // Show/hide and update next button
      if (currentStep === 1 && selectedMethod) {
        nextBtn.classList.remove('hidden');
        nextBtn.textContent = 'Next';
      } else if (currentStep === 2 && selectedMethod === 'app') {
        nextBtn.classList.remove('hidden');
        nextBtn.textContent = 'Continue to Verification';
      } else if (currentStep === 3 || (currentStep === 2 && selectedMethod !== 'app')) {
        nextBtn.classList.add('hidden');
      } else {
        nextBtn.classList.add('hidden');
      }
    }

    // Navigation button handlers
    document.getElementById('next-step-btn')?.addEventListener('click', () => {
      if (currentStep === 1 && selectedMethod) {
        if (selectedMethod === 'app') {
          showStep(2);
        } else {
          showStep(3);
        }
      } else if (currentStep === 2 && selectedMethod === 'app') {
        showStep(3);
      }
    });

    document.getElementById('prev-step-btn')?.addEventListener('click', () => {
      if (currentStep > 1) {
        showStep(currentStep - 1);
      }
    });

    // Verification code input handling
    const codeInputs = ['code-1', 'code-2', 'code-3', 'code-4', 'code-5', 'code-6'];
    codeInputs.forEach((id, index) => {
      const input = document.getElementById(id);
      if (input) {
        input.addEventListener('input', (e) => {
          const value = e.target.value;
          if (value && index < codeInputs.length - 1) {
            document.getElementById(codeInputs[index + 1]).focus();
          }
        });
        
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && !e.target.value && index > 0) {
            document.getElementById(codeInputs[index - 1]).focus();
          }
        });
      }
    });

    // Verify code button
    document.getElementById('verify-code-btn')?.addEventListener('click', () => {
      const button = event.target;
      const originalText = button.textContent;
      
      // Get entered code
      const code = codeInputs.map(id => document.getElementById(id).value).join('');
      
      if (code.length !== 6) {
        alert('Please enter the complete 6-digit code');
        return;
      }
      
      button.textContent = 'Verifying...';
      button.disabled = true;
      
      setTimeout(() => {
        if (code === '123456' || code === '000000') { // Demo codes for testing
          button.textContent = 'Verified!';
          
          // Add new device to list
          addNewDevice(selectedMethod);
          
          setTimeout(() => {
            document.getElementById('setup-wizard').classList.add('hidden');
            resetSetupWizard();
          }, 1500);
        } else {
          button.textContent = 'Invalid Code - Try Again';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);
        }
      }, 1500);
    });

    // Add new device to the list
    function addNewDevice(method) {
      const devicesList = document.getElementById('devices-list');
      const deviceCount = document.getElementById('device-count');
      
      const methodInfo = {
        app: { name: 'Authenticator App', icon: 'phone', color: 'blue' },
        sms: { name: 'SMS Authentication', icon: 'message', color: 'green' },
        hardware: { name: 'Hardware Key', icon: 'key', color: 'purple' }
      };
      
      const info = methodInfo[method];
      const deviceId = `device-${Date.now()}`;
      
      const deviceCard = document.createElement('div');
      deviceCard.className = 'device-card bg-slate-800/30 rounded-lg p-4 border border-slate-600/50';
      deviceCard.innerHTML = `
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <div class="w-10 h-10 bg-${info.color}-600 rounded-lg flex items-center justify-center mr-4">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-medium">${info.name}</h3>
              <p class="text-sm text-slate-400">Added just now</p>
              <p class="text-xs text-green-400 mt-1">● Active</p>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <button class="px-3 py-1 bg-slate-700 hover:bg-slate-600 text-white rounded text-sm transition-colors">
              Test
            </button>
            <button class="px-3 py-1 bg-red-600 hover:bg-red-700 text-white rounded text-sm transition-colors" onclick="removeDevice('${deviceId}')">
              Remove
            </button>
          </div>
        </div>
      `;
      
      // Insert before the placeholder
      const placeholder = document.getElementById('add-device-placeholder');
      devicesList.insertBefore(deviceCard, placeholder);
      
      // Update device count
      const currentCount = parseInt(deviceCount.textContent);
      deviceCount.textContent = currentCount + 1;
    }

    // Remove device function
    function removeDevice(deviceId) {
      if (confirm('Are you sure you want to remove this authentication device?')) {
        const deviceCard = event.target.closest('.device-card');
        deviceCard.remove();
        
        // Update device count
        const deviceCount = document.getElementById('device-count');
        const currentCount = parseInt(deviceCount.textContent);
        deviceCount.textContent = Math.max(0, currentCount - 1);
      }
    }

    // Backup codes modal
    function showBackupCodes() {
      document.getElementById('backup-codes-modal').classList.remove('hidden');
      document.getElementById('backup-codes-modal').classList.add('flex');
    }

    function hideBackupCodes() {
      document.getElementById('backup-codes-modal').classList.add('hidden');
      document.getElementById('backup-codes-modal').classList.remove('flex');
    }

    // Backup codes button
    document.getElementById('backup-codes-btn')?.addEventListener('click', showBackupCodes);

    // Disable MFA button
    document.getElementById('disable-mfa-btn')?.addEventListener('click', () => {
      if (confirm('Are you sure you want to disable multi-factor authentication? This will make your account less secure.')) {
        const button = event.target;
        const originalText = button.textContent;
        
        button.textContent = 'Disabling...';
        button.disabled = true;
        
        setTimeout(() => {
          alert('MFA has been disabled. You can re-enable it at any time.');
          // In a real app, you would redirect or update the UI
          button.textContent = originalText;
          button.disabled = false;
        }, 2000);
      }
    });

    // Make functions global for onclick handlers
    window.removeDevice = removeDevice;
    window.showBackupCodes = showBackupCodes;
    window.hideBackupCodes = hideBackupCodes;

    // Initialize
    updateWizardButtons();
  </script>
