---
title: "JML Lifecycle Demo - AtlasIT"
---

<html lang="en">
  <head>
    <title>JML Lifecycle Demo - AtlasIT</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    
    <style>
      .nav-link { transition: all 0.2s ease; }
      .nav-link:hover { transform: translateY(-1px); }
      .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
      .glass-effect { backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.1); }
      .demo-banner { 
        background: linear-gradient(90deg, rgba(37,99,235,0.25), rgba(168,85,247,0.25)); 
        border: 1px solid rgba(59,130,246,0.35); 
        border-radius: 0.75rem; 
        color: #bfdbfe; 
        font-size: 0.75rem; 
        letter-spacing: 0.08em; 
        padding: 0.6rem 1rem; 
        text-transform: uppercase; 
        text-align: center; 
        margin: 1.5rem auto 0; 
        max-width: 60rem; 
      }
      
      .scenario-card {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(71, 85, 105, 0.5);
        transition: all 0.3s ease;
      }
      .scenario-card:hover {
        border-color: rgba(59, 130, 246, 0.5);
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
      }
      
      .scenario-active {
        border-color: rgba(34, 197, 94, 0.7) !important;
        background: rgba(34, 197, 94, 0.1);
      }
      
      .step-indicator {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.875rem;
      }
      
      .step-complete {
        background: rgb(34, 197, 94);
        color: white;
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.2);
      }
      
      .step-current {
        background: rgb(59, 130, 246);
        color: white;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2);
        animation: pulse 2s infinite;
      }
      
      .step-pending {
        background: rgba(71, 85, 105, 0.5);
        color: rgb(148, 163, 184);
        border: 2px solid rgba(71, 85, 105, 0.3);
      }
      
      @keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
      }
      
      .progress-bar {
        height: 4px;
        background: rgba(71, 85, 105, 0.3);
        border-radius: 2px;
        overflow: hidden;
      }
      
      .progress-fill {
        height: 100%;
        background: linear-gradient(to right, rgb(34, 197, 94), rgb(59, 130, 246));
        transition: width 0.8s ease;
      }
      
      .log-entry {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(71, 85, 105, 0.3);
        border-radius: 0.5rem;
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        animation: slideIn 0.3s ease;
      }
      
      @keyframes slideIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
      }
      
      .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      
      .btn-primary {
        background: linear-gradient(135deg, rgb(59, 130, 246), rgb(37, 99, 235));
        color: white;
        box-shadow: 0 4px 14px 0 rgba(59, 130, 246, 0.4);
      }
      
      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px 0 rgba(59, 130, 246, 0.6);
      }
      
      .btn-primary:disabled {
        background: rgba(71, 85, 105, 0.5);
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
      }
      
      .btn-secondary {
        background: rgba(71, 85, 105, 0.5);
        color: rgb(203, 213, 225);
        border: 1px solid rgba(71, 85, 105, 0.3);
      }
      
      .btn-secondary:hover {
        background: rgba(71, 85, 105, 0.7);
        transform: translateY(-1px);
      }
      
      .btn-success {
        background: linear-gradient(135deg, rgb(34, 197, 94), rgb(22, 163, 74));
        color: white;
        box-shadow: 0 4px 14px 0 rgba(34, 197, 94, 0.4);
      }
      
      .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px 0 rgba(34, 197, 94, 0.6);
      }
      
      .system-badge {
        background: rgba(59, 130, 246, 0.2);
        border: 1px solid rgba(59, 130, 246, 0.4);
        color: rgb(147, 197, 253);
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        font-weight: 500;
      }
      
      .employee-card {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(147, 51, 234, 0.1));
        border: 1px solid rgba(59, 130, 246, 0.3);
      }
      
      .workflow-visual {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(71, 85, 105, 0.3);
        border-radius: 1rem;
        padding: 1.5rem;
      }
      
      .status-success { color: rgb(34, 197, 94); }
      .status-info { color: rgb(59, 130, 246); }
      .status-warning { color: rgb(245, 158, 11); }
      .status-error { color: rgb(239, 68, 68); }
    </style>
  </head>
  <body class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-slate-100 min-h-screen">
    <!-- Header -->
    <header class="glass-effect border-b border-slate-700/50 sticky top-0 z-50">
      <nav class="container mx-auto px-6 py-4">
        <div class="flex justify-between items-center">
          <div class="flex items-center space-x-2">
            <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-purple-600 rounded-lg flex items-center justify-center">
              <span class="text-white font-bold text-sm">AI</span>
            </div>
            <h1 class="text-xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">AtlasIT</h1>
          </div>

          <!-- Desktop Navigation -->
          <div class="hidden md:flex items-center space-x-1">
            <a href="/dashboard" class="nav-link px-4 py-2 rounded-lg hover:bg-slate-700/50 text-slate-300 hover:text-white transition-all duration-200">Dashboard</a>
            <a href="/onboarding" class="nav-link px-4 py-2 rounded-lg hover:bg-slate-700/50 text-slate-300 hover:text-white transition-all duration-200">Onboarding</a>
            <a href="/marketplace" class="nav-link px-4 py-2 rounded-lg hover:bg-slate-700/50 text-slate-300 hover:text-white transition-all duration-200">Marketplace</a>
            <a href="/orchestrator" class="nav-link px-4 py-2 rounded-lg hover:bg-slate-700/50 text-slate-300 hover:text-white transition-all duration-200">Orchestrator</a>
            <a href="/api-manager" class="nav-link px-4 py-2 rounded-lg hover:bg-slate-700/50 text-slate-300 hover:text-white transition-all duration-200">API Manager</a>
            <a href="/jml-demo" class="nav-link px-4 py-2 rounded-lg bg-gradient-to-r from-blue-600 to-purple-600 text-white">JML Demo</a>

            <!-- IT Dropdown -->
            <div class="relative group">
              <button class="nav-link px-4 py-2 rounded-lg hover:bg-slate-700/50 text-slate-300 hover:text-white transition-all duration-200 flex items-center">
                IT <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute top-full left-0 mt-1 w-48 bg-slate-800 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-slate-700">
                <a href="/it/policies" class="block px-4 py-2 text-slate-300 hover:text-white hover:bg-slate-700/50 rounded-t-lg">Policies</a>
                <a href="/it/backup" class="block px-4 py-2 text-slate-300 hover:text-white hover:bg-slate-700/50 rounded-b-lg">Backup & Recovery</a>
              </div>
            </div>

            <!-- Security Dropdown -->
            <div class="relative group">
              <button class="nav-link px-4 py-2 rounded-lg hover:bg-slate-700/50 text-slate-300 hover:text-white transition-all duration-200 flex items-center">
                Security <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute top-full left-0 mt-1 w-48 bg-slate-800 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-slate-700">
                <a href="/security" class="block px-4 py-2 text-slate-300 hover:text-white hover:bg-slate-700/50 rounded-t-lg">Security Center</a>
                <a href="/enhanced-security-scanner" class="block px-4 py-2 text-slate-300 hover:text-white hover:bg-slate-700/50 rounded-b-lg">Scanner</a>
              </div>
            </div>

            <!-- Governance Dropdown -->
            <div class="relative group">
              <button class="nav-link px-4 py-2 rounded-lg hover:bg-slate-700/50 text-slate-300 hover:text-white transition-all duration-200 flex items-center">
                Governance <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute top-full left-0 mt-1 w-48 bg-slate-800 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-slate-700">
                <a href="/governance/compliance" class="block px-4 py-2 text-slate-300 hover:text-white hover:bg-slate-700/50 rounded-lg">Compliance</a>
              </div>
            </div>

            <div class="w-px h-6 bg-slate-600 mx-2"></div>
            <a href="/login" class="nav-link px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white transition-all duration-200">Login</a>
            <a href="/register" class="nav-link px-4 py-2 rounded-lg bg-purple-600 hover:bg-purple-700 text-white transition-all duration-200">Register</a>
          </div>

          <!-- Mobile Menu Button -->
          <button id="mobile-menu-btn" class="md:hidden text-slate-300 hover:text-white p-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <div id="app">
      <div class="demo-banner">
        🚀 Interactive JML Lifecycle Demo - Enterprise IAM Automation
      </div>
      
      <div class="container mx-auto px-4 py-8">
        <div class="text-center mb-12">
          <h1 class="text-5xl font-bold mb-4 bg-gradient-to-r from-blue-400 via-purple-400 to-blue-400 bg-clip-text text-transparent">
            JML Lifecycle Demo
          </h1>
          <p class="text-xl text-slate-300 max-w-3xl mx-auto">
            Experience automated onboarding, role changes, and offboarding workflows powered by HRIS integration, Okta API, and AWS IAM automation
          </p>
        </div>

        <!-- Demo Controls -->
        <div class="glass-effect p-6 rounded-xl border border-slate-700/50 mb-8">
          <div class="flex flex-wrap justify-center gap-4">
            <button @click="resetDemo" class="btn btn-secondary">
              🔄 Reset Demo
            </button>
            <button @click="runFullDemo" class="btn btn-primary" :disabled="demoRunning">
              <span v-if="demoRunning">⏳ Running...</span>
              <span v-else>🚀 Run Complete Demo</span>
            </button>
            <button @click="toggleAutoAdvance" class="btn" :class="autoAdvance ? 'btn-success' : 'btn-secondary'">
              <span v-if="autoAdvance">⏸️ Pause Auto</span>
              <span v-else>▶️ Auto Advance</span>
            </button>
          </div>
        </div>

        <!-- Scenario Selection -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div 
            v-for="scenario in scenarios" 
            :key="scenario.id"
            @click="selectScenario(scenario.id)"
            class="scenario-card cursor-pointer p-6 rounded-xl transition-all duration-300"
            :class="{ 'scenario-active': currentScenario && currentScenario.id === scenario.id }"
          >
            <div class="flex items-center mb-3">
              <div class="text-3xl mr-3">{{ scenario.icon }}</div>
              <div>
                <h3 class="text-xl font-semibold">{{ scenario.title }}</h3>
                <p class="text-sm text-slate-400">{{ scenario.subtitle }}</p>
              </div>
            </div>
            <p class="text-slate-300 mb-4">{{ scenario.description }}</p>
            <div class="progress-bar mb-2">
              <div class="progress-fill" :style="{ width: scenario.progress + '%' }"></div>
            </div>
            <div class="text-xs text-slate-400">{{ scenario.progress }}% Complete</div>
          </div>
        </div>

        <!-- Employee Profile -->
        <div v-if="currentEmployee" class="employee-card p-6 rounded-xl border border-slate-700/50 mb-8">
          <h2 class="text-2xl font-semibold mb-4 flex items-center">
            <span class="mr-3">👤</span> Employee Profile
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div>
              <div class="mb-2"><strong>Name:</strong> {{ currentEmployee.firstName }} {{ currentEmployee.lastName }}</div>
              <div class="mb-2"><strong>Employee ID:</strong> {{ currentEmployee.employeeId }}</div>
              <div class="mb-2"><strong>Email:</strong> {{ currentEmployee.email }}</div>
              <div class="mb-2"><strong>Department:</strong> {{ currentEmployee.department }}</div>
            </div>
            <div>
              <div class="mb-2"><strong>Title:</strong> {{ currentEmployee.title }}</div>
              <div class="mb-2"><strong>Manager:</strong> {{ currentEmployee.manager }}</div>
              <div class="mb-2"><strong>Type:</strong> {{ currentEmployee.employeeType }}</div>
              <div class="mb-2"><strong>Status:</strong> 
                <span :class="getStatusClass(currentEmployee.status)">{{ currentEmployee.status }}</span>
              </div>
            </div>
            <div>
              <div class="mb-2"><strong>Start Date:</strong> {{ currentEmployee.startDate }}</div>
              <div v-if="currentEmployee.endDate" class="mb-2"><strong>End Date:</strong> {{ currentEmployee.endDate }}</div>
              <div v-if="currentEmployee.systemAccess" class="mb-2">
                <strong>System Access:</strong>
                <div class="flex flex-wrap gap-1 mt-1">
                  <span v-for="system in currentEmployee.systemAccess" :key="system" class="system-badge">{{ system }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Workflow Execution -->
        <div v-if="currentScenario" class="workflow-visual mb-8">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-semibold">{{ currentScenario.title }} Workflow</h2>
            <div class="flex gap-3">
              <button 
                @click="previousStep" 
                v-if="currentStepIndex > 0" 
                class="btn btn-secondary"
              >
                ← Previous
              </button>
              <button 
                @click="nextStep" 
                v-if="currentStepIndex < currentScenario.steps.length - 1 && !demoRunning" 
                class="btn btn-primary"
              >
                Next →
              </button>
              <button 
                @click="completeWorkflow" 
                v-if="currentStepIndex === currentScenario.steps.length - 1 && !workflowComplete" 
                class="btn btn-success"
              >
                ✅ Complete Workflow
              </button>
            </div>
          </div>

          <!-- Workflow Steps -->
          <div class="space-y-8">
            <div 
              v-for="(step, index) in currentScenario.steps" 
              :key="index" 
              class="flex items-start space-x-6"
            >
              <div class="flex flex-col items-center">
                <div 
                  class="step-indicator"
                  :class="getStepClass(index)"
                >
                  <span v-if="index < currentStepIndex">✓</span>
                  <span v-else-if="index === currentStepIndex && demoRunning">⏳</span>
                  <span v-else>{{ index + 1 }}</span>
                </div>
                <div 
                  v-if="index < currentScenario.steps.length - 1"
                  class="w-1 h-20 mt-3 rounded"
                  :class="index < currentStepIndex ? 'bg-green-500' : 'bg-slate-600'"
                ></div>
              </div>
              
              <div class="flex-1">
                <h3 class="text-xl font-semibold mb-2 flex items-center">
                  {{ step.title }}
                  <span v-if="index === currentStepIndex && demoRunning" class="ml-2 text-blue-400 animate-spin">⚙️</span>
                </h3>
                <p class="text-slate-300 mb-4">{{ step.description }}</p>
                
                <!-- Systems Involved -->
                <div v-if="step.systems && step.systems.length > 0" class="mb-4">
                  <div class="text-sm font-medium text-slate-400 mb-2">Systems Involved:</div>
                  <div class="flex flex-wrap gap-2">
                    <span 
                      v-for="system in step.systems" 
                      :key="system" 
                      class="system-badge"
                    >
                      {{ system }}
                    </span>
                  </div>
                </div>
                
                <div v-if="step.duration" class="text-sm text-slate-400 mb-4">
                  ⏱️ Estimated Duration: {{ step.duration }}
                </div>
                
                <!-- Real-time Step Logs -->
                <div v-if="stepLogs[index] && stepLogs[index].length > 0" class="space-y-2">
                  <div class="text-sm font-medium text-slate-400 mb-2">📋 Execution Log:</div>
                  <div 
                    v-for="(log, logIndex) in stepLogs[index]" 
                    :key="logIndex" 
                    class="log-entry"
                  >
                    <div class="flex justify-between items-start mb-1">
                      <span class="text-xs text-slate-500">{{ log.timestamp }}</span>
                      <span class="text-xs" :class="getStatusClass(log.type)">{{ log.type.toUpperCase() }}</span>
                    </div>
                    <div class="text-sm text-slate-200">{{ log.message }}</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Real-time Activity Monitor -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Global Activity Log -->
          <div class="workflow-visual">
            <h2 class="text-xl font-semibold mb-4 flex items-center">
              <span class="mr-2">📊</span> Real-time Activity Monitor
            </h2>
            <div v-if="globalLogs.length === 0" class="text-slate-400 text-center py-8">
              🔍 No activity yet. Select a scenario and run the demo to see real-time system interactions.
            </div>
            <div v-else class="space-y-3 max-h-80 overflow-y-auto">
              <div 
                v-for="(log, index) in globalLogs.slice(0, 10)" 
                :key="index" 
                class="log-entry"
              >
                <div class="flex justify-between items-start mb-2">
                  <span class="font-medium" :class="getStatusClass(log.type)">
                    {{ log.system }}
                  </span>
                  <span class="text-xs text-slate-500">{{ log.timestamp }}</span>
                </div>
                <div class="text-sm text-slate-300">{{ log.message }}</div>
              </div>
            </div>
          </div>

          <!-- System Status Dashboard -->
          <div class="workflow-visual">
            <h2 class="text-xl font-semibold mb-4 flex items-center">
              <span class="mr-2">🖥️</span> System Status
            </h2>
            <div class="space-y-4">
              <div v-for="system in systemStatus" :key="system.name" class="flex items-center justify-between p-3 rounded-lg bg-slate-800/50">
                <div class="flex items-center">
                  <div class="w-3 h-3 rounded-full mr-3" :class="system.status === 'active' ? 'bg-green-500' : 'bg-slate-500'"></div>
                  <span class="font-medium">{{ system.name }}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm text-slate-400">{{ system.requests }} req/min</span>
                  <span class="text-xs px-2 py-1 rounded" :class="system.status === 'active' ? 'bg-green-500/20 text-green-400' : 'bg-slate-500/20 text-slate-400'">
                    {{ system.status }}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Enterprise Features Section -->
        <div class="workflow-visual mt-8">
          <h2 class="text-2xl font-semibold mb-6 text-center">Enterprise IAM Automation Features</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="text-center p-4 rounded-lg bg-slate-800/30 hover:bg-slate-800/50 transition-colors">
              <div class="text-4xl mb-3">🏢</div>
              <h3 class="font-semibold mb-2">HRIS Integration</h3>
              <p class="text-sm text-slate-400">BambooHR as source of truth with real-time webhooks</p>
            </div>
            <div class="text-center p-4 rounded-lg bg-slate-800/30 hover:bg-slate-800/50 transition-colors">
              <div class="text-4xl mb-3">🔐</div>
              <h3 class="font-semibold mb-2">Okta API</h3>
              <p class="text-sm text-slate-400">Automated user lifecycle and group management</p>
            </div>
            <div class="text-center p-4 rounded-lg bg-slate-800/30 hover:bg-slate-800/50 transition-colors">
              <div class="text-4xl mb-3">☁️</div>
              <h3 class="font-semibold mb-2">AWS IAM</h3>
              <p class="text-sm text-slate-400">Infrastructure as Code with Terraform automation</p>
            </div>
            <div class="text-center p-4 rounded-lg bg-slate-800/30 hover:bg-slate-800/50 transition-colors">
              <div class="text-4xl mb-3">📊</div>
              <h3 class="font-semibold mb-2">Compliance</h3>
              <p class="text-sm text-slate-400">Full audit trails and automated reporting</p>
            </div>
          </div>
        </div>

        <!-- API Integration Flow -->
        <div class="workflow-visual mt-8">
          <h2 class="text-2xl font-semibold mb-6 text-center">Live API Integration Flow</h2>
          <div class="flex flex-col md:flex-row items-center justify-center space-y-4 md:space-y-0 md:space-x-8">
            <div class="flex items-center space-x-3 p-4 rounded-lg bg-green-600/20 border border-green-600/30">
              <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center">
                <span class="text-white font-bold">HR</span>
              </div>
              <div>
                <div class="font-semibold">BambooHR</div>
                <div class="text-xs text-slate-400">Employee Data Source</div>
              </div>
            </div>
            <div class="text-slate-400 text-2xl">→</div>
            <div class="flex items-center space-x-3 p-4 rounded-lg bg-blue-600/20 border border-blue-600/30">
              <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center">
                <span class="text-white font-bold">API</span>
              </div>
              <div>
                <div class="font-semibold">AtlasIT API</div>
                <div class="text-xs text-slate-400">Orchestration Layer</div>
              </div>
            </div>
            <div class="text-slate-400 text-2xl">→</div>
            <div class="flex items-center space-x-3 p-4 rounded-lg bg-purple-600/20 border border-purple-600/30">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-white font-bold">ID</span>
              </div>
              <div>
                <div class="font-semibold">Okta</div>
                <div class="text-xs text-slate-400">Identity Provider</div>
              </div>
            </div>
            <div class="text-slate-400 text-2xl">→</div>
            <div class="flex items-center space-x-3 p-4 rounded-lg bg-orange-600/20 border border-orange-600/30">
              <div class="w-12 h-12 bg-orange-600 rounded-lg flex items-center justify-center">
                <span class="text-white font-bold">AWS</span>
              </div>
              <div>
                <div class="font-semibold">AWS IAM</div>
                <div class="text-xs text-slate-400">Cloud Infrastructure</div>
              </div>
            </div>
          </div>
          <p class="text-center text-slate-400 mt-6">
            🔄 Real-time integration from HRIS to cloud infrastructure with complete audit trail and automated compliance
          </p>
        </div>
      </div>
    </div>

    <script>
      const { createApp } = Vue;

      createApp({
        data() {
          return {
            currentScenario: null,
            currentEmployee: null,
            currentStepIndex: 0,
            workflowComplete: false,
            demoRunning: false,
            autoAdvance: false,
            stepLogs: {},
            globalLogs: [],
            
            scenarios: [
              {
                id: 'joiner',
                icon: '👋',
                title: 'New Employee',
                subtitle: 'Joiner Workflow',
                description: 'Jordan Miles joins as Security Engineer. Watch automated provisioning across Okta and AWS.',
                progress: 0,
                employee: {
                  employeeId: 'EMP001',
                  firstName: 'Jordan',
                  lastName: 'Miles',
                  email: 'jordan.miles@atlasit.pro',
                  title: 'Security Engineer',
                  department: 'Security',
                  manager: 'security-lead@atlasit.pro',
                  employeeType: 'fulltime',
                  status: 'active',
                  startDate: '2025-01-15',
                  systemAccess: ['HRIS', 'Okta', 'AWS IAM', 'CloudTrail']
                },
                steps: [
                  {
                    title: 'Paycom Employee Created',
                    description: 'HR creates new employee record in Paycom with role requirements',
                    systems: ['Paycom'],
                    duration: '~30s',
                    apiCall: 'POST /api/paycom/employees',
                    payload: 'Employee data with security role requirements'
                  },
                  {
                    title: 'Paycom Webhook Triggered',
                    description: 'Paycom sends employee.created webhook to AtlasIT API Manager',
                    systems: ['Paycom', 'API Manager'],
                    duration: '~5s',
                    apiCall: 'POST /api/webhooks/employee-created',
                    payload: 'Employee lifecycle event data'
                  },
                  {
                    title: 'Okta User Creation',
                    description: 'API Manager calls Okta API to create user account with security group assignments',
                    systems: ['API Manager', 'Okta'],
                    duration: '~15s',
                    apiCall: 'POST /api/v1/users',
                    payload: 'User profile and security group memberships'
                  },
                  {
                    title: 'AWS IAM Role Creation',
                    description: 'AtlasIT creates AWS IAM role with security engineer permissions via direct API',
                    systems: ['AtlasIT', 'AWS IAM'],
                    duration: '~20s',
                    apiCall: 'POST /api/aws/iam/roles',
                    payload: 'Security engineer role and policy definitions'
                  },
                  {
                    title: 'CloudTrail Monitoring Setup',
                    description: 'Automated CloudTrail configuration for new user activity monitoring',
                    systems: ['AtlasIT', 'AWS CloudTrail'],
                    duration: '~10s',
                    apiCall: 'PUT /api/aws/cloudtrail/monitoring',
                    payload: 'User monitoring configuration'
                  },
                  {
                    title: 'Welcome Notification',
                    description: 'Automated welcome email with temporary credentials and security checklist',
                    systems: ['Email Service', 'Okta'],
                    duration: '~5s',
                    apiCall: 'POST /api/notifications/welcome',
                    payload: 'Welcome template with security guidelines'
                  }
                ]
              },
              {
                id: 'mover',
                icon: '🔄',
                title: 'Role Change',
                subtitle: 'Mover Workflow',
                description: 'Alex Chen moves from Developer to DevOps Lead. See automated permission updates.',
                progress: 0,
                employee: {
                  employeeId: 'EMP002',
                  firstName: 'Alex',
                  lastName: 'Chen',
                  email: 'alex.chen@atlasit.pro',
                  title: 'DevOps Lead',
                  department: 'Engineering',
                  manager: 'engineering-director@atlasit.pro',
                  employeeType: 'fulltime',
                  status: 'active',
                  startDate: '2023-03-10',
                  systemAccess: ['HRIS', 'Okta', 'AWS IAM', 'GitHub', 'Docker Registry']
                },
                steps: [
                  {
                    title: 'HRIS Role Update',
                    description: 'HR updates employee record with new title and reporting structure',
                    systems: ['BambooHR'],
                    duration: '~20s',
                    apiCall: 'PUT /api/hris/employees/EMP002',
                    payload: 'Updated role and reporting data'
                  },
                  {
                    title: 'HRIS Webhook - Role Change',
                    description: 'HRIS sends employee.updated webhook to AtlasIT API Manager',
                    systems: ['BambooHR', 'API Manager'],
                    duration: '~5s',
                    apiCall: 'POST /api/webhooks/employee-updated',
                    payload: 'Role change event data'
                  },
                  {
                    title: 'Okta Group Membership Update',
                    description: 'API Manager updates Okta groups: removes Developer, adds DevOps Lead permissions',
                    systems: ['API Manager', 'Okta'],
                    duration: '~25s',
                    apiCall: 'PUT /api/v1/users/{id}/groups',
                    payload: 'Group membership changes'
                  },
                  {
                    title: 'AWS IAM Role Migration',
                    description: 'Terraform updates AWS IAM with elevated DevOps permissions (EC2, Lambda, CloudFormation)',
                    systems: ['Terraform', 'AWS IAM'],
                    duration: '~60s',
                    apiCall: 'terraform apply -target=aws_iam_role',
                    payload: 'Enhanced IAM permissions'
                  },
                  {
                    title: 'Access Review Trigger',
                    description: 'Automated access review created for manager approval of new elevated permissions',
                    systems: ['Compliance Engine', 'Email Service'],
                    duration: '~15s',
                    apiCall: 'POST /api/access-reviews',
                    payload: 'Review request metadata'
                  },
                  {
                    title: 'Team Notification',
                    description: 'Slack notification sent to DevOps team about new team lead',
                    systems: ['Slack API', 'Team Management'],
                    duration: '~10s',
                    apiCall: 'POST /api/slack/notifications',
                    payload: 'Team update message'
                  }
                ]
              },
              {
                id: 'leaver',
                icon: '👋',
                title: 'Employee Exit',
                subtitle: 'Leaver Workflow',
                description: 'Sam Taylor departs the company. Witness complete access deprovisioning and audit trail.',
                progress: 0,
                employee: {
                  employeeId: 'EMP003',
                  firstName: 'Sam',
                  lastName: 'Taylor',
                  email: 'sam.taylor@atlasit.pro',
                  title: 'Marketing Manager',
                  department: 'Marketing',
                  manager: 'marketing-director@atlasit.pro',
                  employeeType: 'fulltime',
                  status: 'terminated',
                  startDate: '2022-06-15',
                  endDate: '2025-01-20',
                  systemAccess: ['HRIS', 'Okta (Disabled)', 'AWS IAM (Revoked)', 'Audit Trail']
                },
                steps: [
                  {
                    title: 'HRIS Termination Recorded',
                    description: 'HR sets employee status to terminated with last working day',
                    systems: ['BambooHR'],
                    duration: '~15s',
                    apiCall: 'PUT /api/hris/employees/EMP003',
                    payload: 'Termination date and status'
                  },
                  {
                    title: 'HRIS Webhook - Termination',
                    description: 'HRIS sends employee.terminated webhook to AtlasIT API Manager',
                    systems: ['BambooHR', 'API Manager'],
                    duration: '~5s',
                    apiCall: 'POST /api/webhooks/employee-terminated',
                    payload: 'Termination event data'
                  },
                  {
                    title: 'Immediate Okta Account Suspension',
                    description: 'API Manager immediately suspends Okta account to prevent further access',
                    systems: ['API Manager', 'Okta'],
                    duration: '~10s',
                    apiCall: 'POST /api/v1/users/{id}/lifecycle/suspend',
                    payload: 'Account suspension directive'
                  },
                  {
                    title: 'AWS IAM Deprovisioning',
                    description: 'Terraform removes all AWS IAM roles and policies associated with user',
                    systems: ['Terraform', 'AWS IAM'],
                    duration: '~45s',
                    apiCall: 'terraform destroy -target=aws_iam_user',
                    payload: 'User resource cleanup'
                  },
                  {
                    title: 'CloudTrail Final Audit',
                    description: 'Lambda generates final access report with complete audit trail for compliance',
                    systems: ['AWS Lambda', 'CloudTrail', 'S3'],
                    duration: '~30s',
                    apiCall: 'POST /api/audit/final-report',
                    payload: 'Audit trail compilation'
                  },
                  {
                    title: 'Data Backup & Account Deletion',
                    description: 'Personal data backed up for retention policy, Okta account scheduled for deletion',
                    systems: ['Backup Service', 'Okta', 'Compliance'],
                    duration: '~90s',
                    apiCall: 'POST /api/data-retention/backup',
                    payload: 'Data archival instructions'
                  },
                  {
                    title: 'Manager & IT Notification',
                    description: 'Automated notifications sent confirming successful deprovisioning',
                    systems: ['Email Service', 'Compliance Dashboard'],
                    duration: '~10s',
                    apiCall: 'POST /api/notifications/deprovisioning-complete',
                    payload: 'Completion confirmation'
                  }
                ]
              }
            ]
          };
        },
        methods: {
          async selectScenario(id) {
            this.currentScenario = this.scenarios.find(s => s.id === id);
            this.currentEmployee = this.currentScenario.employee;
            this.currentStepIndex = 0;
            this.workflowComplete = false;
            this.stepLogs = {};
            
            this.addGlobalLog('info', 'Demo System', `🎯 Selected ${this.currentScenario.title} scenario for ${this.currentEmployee.firstName} ${this.currentEmployee.lastName}`);
            
            // Save demo state to D1
            await this.saveDemoState();
          },
          
          async nextStep() {
            if (this.currentStepIndex < this.currentScenario.steps.length - 1) {
              await this.executeStep(this.currentStepIndex);
              this.currentStepIndex++;
              this.updateProgress();
              await this.saveDemoState();
            }
          },
          
          async previousStep() {
            if (this.currentStepIndex > 0) {
              this.currentStepIndex--;
              this.updateProgress();
              await this.saveDemoState();
            }
          },
          
          async executeStep(stepIndex) {
            const step = this.currentScenario.steps[stepIndex];
            
            this.addStepLog(stepIndex, `🚀 Executing: ${step.title}`);
            this.addGlobalLog('info', step.systems[0], `▶️ Starting: ${step.title}`);
            
            // Simulate API call
            await this.delay(200);
            this.addStepLog(stepIndex, `📡 API Call: ${step.apiCall}`);
            this.addStepLog(stepIndex, `📦 Payload: ${step.payload}`);
            
            // Simulate processing time
            await this.delay(800);
            this.addStepLog(stepIndex, `⚙️ Processing: ${step.description}`);
            
            // Simulate completion
            await this.delay(500);
            this.addStepLog(stepIndex, `✅ ${step.title} completed successfully`);
            this.addGlobalLog('success', step.systems[step.systems.length - 1], `✅ Completed: ${step.title} (${step.duration})`);
            
            // Save to D1/R2
            await this.saveStepResult(stepIndex, step);
          },
          
          async completeWorkflow() {
            this.workflowComplete = true;
            this.currentScenario.progress = 100;
            await this.executeStep(this.currentStepIndex);
            this.addGlobalLog('success', 'Demo System', `🎉 ${this.currentScenario.title} workflow completed for ${this.currentEmployee.firstName} ${this.currentEmployee.lastName}`);
            
            // Save final state
            await this.saveDemoState();
            await this.saveAuditTrail();
          },
          
          async resetDemo() {
            this.currentScenario = null;
            this.currentEmployee = null;
            this.currentStepIndex = 0;
            this.workflowComplete = false;
            this.demoRunning = false;
            this.autoAdvance = false;
            this.stepLogs = {};
            this.globalLogs = [];
            
            // Reset progress for all scenarios
            this.scenarios.forEach(scenario => {
              scenario.progress = 0;
            });
            
            this.addGlobalLog('info', 'Demo System', '🔄 Demo reset - ready for new scenario');
            
            // Clear D1 demo state
            await this.clearDemoState();
          },
          
          async runFullDemo() {
            if (!this.currentScenario) {
              this.addGlobalLog('warning', 'Demo System', '⚠️ Please select a scenario first');
              return;
            }
            
            this.demoRunning = true;
            this.currentStepIndex = 0;
            this.workflowComplete = false;
            
            this.addGlobalLog('info', 'Demo System', `🎬 Starting full demo for ${this.currentScenario.title}`);
            
            for (let i = 0; i < this.currentScenario.steps.length; i++) {
              this.currentStepIndex = i;
              await this.executeStep(i);
              this.updateProgress();
              
              if (i < this.currentScenario.steps.length - 1) {
                await this.delay(1500); // Pause between steps
              }
            }
            
            await this.completeWorkflow();
            this.demoRunning = false;
          },
          
          toggleAutoAdvance() {
            this.autoAdvance = !this.autoAdvance;
            if (this.autoAdvance) {
              this.addGlobalLog('info', 'Demo System', '⏯️ Auto-advance enabled');
              this.autoAdvanceSteps();
            } else {
              this.addGlobalLog('info', 'Demo System', '⏸️ Auto-advance paused');
            }
          },
          
          async autoAdvanceSteps() {
            while (this.autoAdvance && this.currentScenario && this.currentStepIndex < this.currentScenario.steps.length - 1) {
              await this.delay(3000);
              if (this.autoAdvance) {
                await this.nextStep();
              }
            }
            
            if (this.autoAdvance && this.currentScenario && this.currentStepIndex === this.currentScenario.steps.length - 1) {
              await this.completeWorkflow();
              this.autoAdvance = false;
            }
          },
          
          updateProgress() {
            if (this.currentScenario) {
              const progress = Math.round(((this.currentStepIndex + 1) / this.currentScenario.steps.length) * 100);
              this.currentScenario.progress = progress;
            }
          },
          
          addStepLog(stepIndex, message) {
            if (!this.stepLogs[stepIndex]) {
              this.stepLogs[stepIndex] = [];
            }
            
            this.stepLogs[stepIndex].push({
              timestamp: new Date().toLocaleTimeString(),
              message: message
            });
          },
          
          addGlobalLog(type, system, message) {
            this.globalLogs.unshift({
              timestamp: new Date().toLocaleTimeString(),
              type: type,
              system: system,
              message: message
            });
            
            // Keep only last 100 logs
            if (this.globalLogs.length > 100) {
              this.globalLogs = this.globalLogs.slice(0, 100);
            }
          },
          
          delay(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
          },
          
          // D1/R2 Integration Methods
          async saveDemoState() {
            try {
              const state = {
                scenario: this.currentScenario ? this.currentScenario.id : null,
                employee: this.currentEmployee,
                stepIndex: this.currentStepIndex,
                progress: this.currentScenario ? (this.currentScenario.progress || 0) : 0,
                timestamp: new Date().toISOString(),
                logs: this.globalLogs.slice(0, 10) // Save recent logs
              };
              
              // Save to D1 database
              await fetch('/api/demo/state', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(state)
              });
              
              console.log('📀 Demo state saved to D1');
            } catch (error) {
              console.error('Failed to save demo state:', error);
            }
          },
          
          async saveStepResult(stepIndex, step) {
            try {
              const result = {
                scenarioId: this.currentScenario.id,
                stepIndex: stepIndex,
                step: step,
                employee: this.currentEmployee,
                timestamp: new Date().toISOString(),
                logs: this.stepLogs[stepIndex] || []
              };
              
              // Save step result to R2 bucket
              await fetch('/api/demo/steps', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(result)
              });
              
              console.log(`💾 Step ${stepIndex + 1} result saved to R2`);
            } catch (error) {
              console.error('Failed to save step result:', error);
            }
          },
          
          async saveAuditTrail() {
            try {
              const auditTrail = {
                scenarioId: this.currentScenario.id,
                employee: this.currentEmployee,
                completionTime: new Date().toISOString(),
                totalSteps: this.currentScenario.steps.length,
                allLogs: this.globalLogs,
                stepResults: this.stepLogs
              };
              
              // Save complete audit trail to R2
              await fetch('/api/demo/audit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(auditTrail)
              });
              
              this.addGlobalLog('success', 'Audit System', '📋 Complete audit trail saved for compliance');
            } catch (error) {
              console.error('Failed to save audit trail:', error);
            }
          },
          
          async clearDemoState() {
            try {
              await fetch('/api/demo/state', { method: 'DELETE' });
              console.log('🗑️ Demo state cleared from D1');
            } catch (error) {
              console.error('Failed to clear demo state:', error);
            }
          },
          
          async loadDemoState() {
            try {
              const response = await fetch('/api/demo/state');
              if (response.ok) {
                const state = await response.json();
                if (state.scenario) {
                  this.currentScenario = this.scenarios.find(s => s.id === state.scenario);
                  this.currentEmployee = state.employee;
                  this.currentStepIndex = state.stepIndex;
                  if (this.currentScenario) {
                    this.currentScenario.progress = state.progress;
                  }
                  this.globalLogs = state.logs || [];
                  
                  this.addGlobalLog('info', 'Demo System', '📤 Previous demo state restored');
                }
              }
            } catch (error) {
              console.error('Failed to load demo state:', error);
            }
          }
        },
        
        async mounted() {
          this.addGlobalLog('success', 'Demo System', '🚀 JML Lifecycle Demo initialized - Ready for enterprise demonstration');
          
          // Load any previous demo state
          await this.loadDemoState();
          
          // Start real-time metrics updates
          this.startMetricsUpdates();
        },
        
        startMetricsUpdates() {
          // Update metrics every 30 seconds
          setInterval(async () => {
            try {
              const response = await fetch('/api/demo/metrics');
              if (response.ok) {
                const metrics = await response.json();
                this.updateDashboardMetrics(metrics);
              }
            } catch (error) {
              console.error('Failed to update metrics:', error);
            }
          }, 30000);
        },
        
        updateDashboardMetrics(metrics) {
          if (metrics.statistics) {
            this.addGlobalLog('info', 'Metrics System', 
              `📊 Total Workflows: ${metrics.statistics.totalWorkflows}, Steps: ${metrics.statistics.totalSteps}, Employees: ${metrics.statistics.uniqueEmployees}`
            );
          }
        }
      }).mount('#app');
    </script>
  </body>
</html>
