    // Get current configuration
    function getCurrentConfig() {
      return {
        companyName: document.getElementById('company-name').value,
        industry: document.getElementById('industry').value,
        companySize: document.getElementById('company-size').value,
        compliance: Array.from(document.querySelectorAll('input[type="checkbox"]:checked')).map(cb => cb.id)
      };
    }

    // Regenerate specific policy
    function regeneratePolicy(policyType) {
      const config = getCurrentConfig();
      const template = policyTemplates[policyType];
      
      if (!template) return;
      
      const previewElement = document.getElementById(`${policyType}-preview`);
      if (!previewElement) return;
      
      // Show generation animation
      previewElement.innerHTML = `
        <div class="flex items-center justify-center py-8">
          <div class="generation-progress w-32 mb-2"></div>
        </div>
        <div class="text-center text-slate-400">Generating ${template.title}...</div>
      `;
      
      // Simulate AI generation delay
      setTimeout(() => {
        previewElement.innerHTML = template.generateContent(config);
      }, 1500);
    }

    // Regenerate all policies
    document.getElementById('regenerate-all')?.addEventListener('click', () => {
      const button = event.target;
      const originalText = button.textContent;
      
      button.textContent = 'Regenerating...';
      button.disabled = true;
      
      // Regenerate each policy with staggered timing
      const policies = Object.keys(policyTemplates);
      policies.forEach((policyType, index) => {
        setTimeout(() => {
          regeneratePolicy(policyType);
        }, index * 500);
      });
      
      setTimeout(() => {
        button.textContent = 'Regeneration Complete!';
        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
        }, 1500);
      }, policies.length * 500 + 1500);
    });

    // Update configuration
    document.getElementById('update-config')?.addEventListener('click', () => {
      const button = event.target;
      const originalText = button.textContent;
      
      button.textContent = 'Updating...';
      button.disabled = true;
      
      setTimeout(() => {
        button.textContent = 'Updated!';
        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
        }, 1000);
      }, 1000);
    });

    // Export policies
    document.getElementById('export-policies')?.addEventListener('click', () => {
      const config = getCurrentConfig();
      const button = event.target;
      const originalText = button.textContent;
      
      button.textContent = 'Exporting...';
      button.disabled = true;
      
      setTimeout(() => {
        // Simulate file download
        const link = document.createElement('a');
        link.href = 'data:text/plain;charset=utf-8,' + encodeURIComponent(`${config.companyName} IT Policies - Generated by AtlasIT\\n\\nExported on: ${new Date().toLocaleDateString()}`);
        link.download = `${config.companyName}_IT_Policies.txt`;
        link.click();
        
        button.textContent = 'Exported!';
        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
        }, 1500);
      }, 1000);
    });

    // Create custom policy
    document.getElementById('create-custom-policy')?.addEventListener('click', () => {
      const policyName = prompt('Enter the name for your custom policy:');
      if (policyName) {
        alert(`Custom policy "${policyName}" will be generated based on your current configuration. This feature is coming soon!`);
      }
    });

    // Auto-update policies when configuration changes
    ['company-name', 'industry', 'company-size'].forEach(id => {
      document.getElementById(id)?.addEventListener('change', () => {
        // Could trigger auto-regeneration here if desired
        console.log('Configuration changed - policies may need regeneration');
      });
    });

    // Initialize with current configuration
    window.addEventListener('load', () => {
      console.log('Policy generation system initialized with HardWorkCo defaults');
    });

    // Make regeneratePolicy global for onclick handlers
    window.regeneratePolicy = regeneratePolicy;
  </script>
</body>
</html>
