# Environment Configuration for AtlasIT API Manager

# Server Configuration
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001

# Authentication & Security
JWT_SECRET=your-super-secure-jwt-secret-here
API_KEY=atlasit-demo-api-key
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000

# Okta Configuration
OKTA_DOMAIN=your-okta-domain.okta.com
OKTA_CLIENT_ID=your-okta-client-id
OKTA_CLIENT_SECRET=your-okta-client-secret
OKTA_API_TOKEN=your-okta-api-token
OKTA_PRIVATE_KEY=your-okta-private-key

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_ACCOUNT_ID=123456789012

# Terraform Configuration
TERRAFORM_WORKSPACE_PATH=../terraform/aws-iam-demo
TERRAFORM_STATE_BUCKET=atlasit-terraform-state
TERRAFORM_LOCK_TABLE=atlasit-terraform-locks

# Microsoft Azure/Entra ID Configuration
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# Google Workspace Configuration
GOOGLE_WORKSPACE_DOMAIN=atlasit.pro
GOOGLE_SERVICE_ACCOUNT_KEY=your-google-service-account-key.json

# KnowBe4 Configuration
KNOWBE4_API_TOKEN=your-knowbe4-api-token
KNOWBE4_DOMAIN=your-knowbe4-domain

# HRIS Configuration  
HRIS_API_KEY=your-hris-api-key
HRIS_BASE_URL=https://api.bamboohr.com/api/gateway.php/atlasit

# Active Directory Configuration
AD_DOMAIN=corp.atlasit.local
AD_SERVER=dc01.corp.atlasit.local
AD_USERNAME=svc-atlasit-automation
AD_PASSWORD=your-ad-service-password

# Logging & Monitoring
LOG_LEVEL=info
LOG_FILE=logs/api-manager.log
METRICS_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Demo Mode
DEMO_MODE=true
DEMO_DATA_RESET_INTERVAL=3600000
