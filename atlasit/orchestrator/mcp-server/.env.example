# MCP Server Example Environment Variables
SESSION_SECRET=atlasit-mcp-secret
MCP_BEARER_TOKEN=your-strong-shared-secret
MCP_DB_PATH=./mcp-docs.sqlite
MCP_SEED_DOCS=true
