{
  "name": "Access Control Management",
  "description": "Process access requests with simulated connectors and change approvals",
  "category": "access-control",
  "version": "2.0.0",
  "metadata": {
    "author": "AtlasIT",
    "tags": ["access", "approvals", "automation"],
    "estimatedDuration": "12 minutes",
    "complexity": "medium",
    "changeManagement": "Simulated Jira approvals"
  },
  "resources": {
    "connectors": {
      "activeDirectory": "{{connectors.activeDirectory}}",
      "jira": "{{connectors.jira}}"
    }
  },
  "cards": [
    {
      "id": "trigger-card",
      "type": "trigger",
      "name": "Access Request",
      "config": {
        "triggerType": "webhook",
        "schema": {
          "type": "object",
          "required": ["email", "group", "action"],
          "properties": {
            "email": { "type": "string", "format": "email" },
            "group": { "type": "string" },
            "action": { "type": "string", "enum": ["grant", "revoke"] },
            "justification": { "type": "string" }
          }
        }
      },
      "outputs": {
        "request": "request"
      }
    },
    {
      "id": "create-change",
      "type": "connector-action",
      "name": "Create Change Ticket",
      "config": {
        "connector": "jira",
        "action": "create-issue",
        "parameters": {
          "projectKey": "OPS",
          "summary": "{{request.action}} access for {{request.email}}",
          "description": "Group {{request.group}}",
          "changeType": "Standard",
          "approvers": ["security@example.com"]
        }
      }
    },
    {
      "id": "approve-change",
      "type": "connector-action",
      "name": "Approve Change",
      "config": {
        "connector": "jira",
        "action": "transition-issue",
        "parameters": {
          "issueKey": "{{card.create-change.output.payload.issueKey}}",
          "status": "Approved"
        }
      }
    },
    {
      "id": "update-access",
      "type": "connector-action",
      "name": "Update Active Directory Access",
      "config": {
        "connector": "activeDirectory",
        "action": "assign-groups",
        "parameters": {
          "email": "{{request.email}}",
          "groups": ["{{request.group}}"]
        }
      }
    }
  ],
  "connections": [
    { "from": "trigger-card", "to": "create-change", "type": "success" },
    { "from": "create-change", "to": "approve-change", "type": "success" },
    { "from": "approve-change", "to": "update-access", "type": "success" }
  ]
}
