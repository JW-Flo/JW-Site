{
  "name": "User System Migration",
  "description": "Simulate migrating a user account with audit trail",
  "category": "system-integration",
  "version": "2.0.0",
  "metadata": {
    "author": "AtlasIT",
    "tags": ["migration", "identity", "automation"],
    "estimatedDuration": "20 minutes",
    "complexity": "high",
    "changeManagement": "Simulated Jira and Confluence used for approvals/docs"
  },
  "resources": {
    "connectors": {
      "activeDirectory": "{{connectors.activeDirectory}}",
      "office365": "{{connectors.office365}}",
      "jira": "{{connectors.jira}}",
      "confluence": "{{connectors.confluence}}"
    }
  },
  "cards": [
    {
      "id": "trigger-card",
      "type": "trigger",
      "name": "Migration Request",
      "config": {
        "triggerType": "webhook",
        "schema": {
          "type": "object",
          "required": ["email", "targetSystem"],
          "properties": {
            "email": { "type": "string", "format": "email" },
            "targetSystem": { "type": "string", "enum": ["activeDirectory", "microsoft365"] }
          }
        }
      },
      "outputs": {
        "migration": "migration"
      }
    },
    {
      "id": "open-change",
      "type": "connector-action",
      "name": "Open Migration Change",
      "config": {
        "connector": "jira",
        "action": "create-issue",
        "parameters": {
          "projectKey": "OPS",
          "summary": "Migrate {{migration.email}} to {{migration.targetSystem}}",
          "description": "Migration initiated via automation",
          "changeType": "Standard",
          "approvers": ["ops@example.com"]
        }
      }
    },
    {
      "id": "approve-change",
      "type": "connector-action",
      "name": "Approve Migration",
      "config": {
        "connector": "jira",
        "action": "transition-issue",
        "parameters": {
          "issueKey": "{{card.open-change.output.payload.issueKey}}",
          "status": "Approved"
        }
      }
    },
    {
      "id": "create-target",
      "type": "connector-action",
      "name": "Create Target Account",
      "config": {
        "connector": "office365",
        "action": "create-user",
        "parameters": {
          "email": "{{migration.email}}",
          "firstName": "Auto",
          "lastName": "Migrated",
          "licenses": []
        }
      }
    },
    {
      "id": "disable-source",
      "type": "connector-action",
      "name": "Disable Source Account",
      "config": {
        "connector": "activeDirectory",
        "action": "disable-user",
        "parameters": {
          "email": "{{migration.email}}",
          "reason": "Post-migration"
        }
      }
    },
    {
      "id": "document-migration",
      "type": "connector-action",
      "name": "Document Migration",
      "config": {
        "connector": "confluence",
        "action": "publish-page",
        "parameters": {
          "spaceKey": "OPS",
          "title": "Migration - {{migration.email}}",
          "body": "Migration completed with change {{card.open-change.output.payload.issueKey}}",
          "labels": ["migration", "change-management"]
        }
      }
    }
  ],
  "connections": [
    { "from": "trigger-card", "to": "open-change", "type": "success" },
    { "from": "open-change", "to": "approve-change", "type": "success" },
    { "from": "approve-change", "to": "create-target", "type": "success" },
    { "from": "create-target", "to": "disable-source", "type": "success" },
    { "from": "disable-source", "to": "document-migration", "type": "success" }
  ]
}
