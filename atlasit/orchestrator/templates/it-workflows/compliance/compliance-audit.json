{
  "name": "Compliance Audit Workflow",
  "description": "Simulated compliance audit capturing approvals and documentation",
  "category": "compliance",
  "version": "2.0.0",
  "metadata": {
    "author": "AtlasIT",
    "tags": ["compliance", "audit", "automation"],
    "estimatedDuration": "30 minutes",
    "complexity": "medium",
    "changeManagement": "Jira ticket + Confluence report (simulated)"
  },
  "resources": {
    "connectors": {
      "jira": "{{connectors.jira}}",
      "confluence": "{{connectors.confluence}}",
      "dropbox": "{{connectors.dropbox}}"
    }
  },
  "cards": [
    {
      "id": "trigger-card",
      "type": "trigger",
      "name": "Start Audit",
      "config": {
        "triggerType": "schedule",
        "schema": {
          "type": "object",
          "properties": {
            "framework": { "type": "string", "default": "SOX" },
            "scope": { "type": "string", "default": "all-users" }
          }
        }
      },
      "outputs": {
        "audit": "audit"
      }
    },
    {
      "id": "open-audit-ticket",
      "type": "connector-action",
      "name": "Open Audit Ticket",
      "config": {
        "connector": "jira",
        "action": "create-issue",
        "parameters": {
          "projectKey": "OPS",
          "summary": "Compliance audit for {{audit.framework}}",
          "description": "Automated audit scope {{audit.scope}}",
          "changeType": "Standard",
          "approvers": ["compliance@example.com"]
        }
      }
    },
    {
      "id": "approve-audit",
      "type": "connector-action",
      "name": "Approve Audit",
      "config": {
        "connector": "jira",
        "action": "transition-issue",
        "parameters": {
          "issueKey": "{{card.open-audit-ticket.output.payload.issueKey}}",
          "status": "In Progress"
        }
      }
    },
    {
      "id": "collect-evidence",
      "type": "connector-action",
      "name": "Collect Evidence",
      "config": {
        "connector": "dropbox",
        "action": "listTeamFolders",
        "parameters": {
          "limit": 50
        }
      }
    },
    {
      "id": "document-audit",
      "type": "connector-action",
      "name": "Document Audit",
      "config": {
        "connector": "confluence",
        "action": "publish-page",
        "parameters": {
          "spaceKey": "OPS",
          "title": "Compliance Audit - {{audit.framework}}",
          "body": "Audit evidence collected. Jira ticket {{card.open-audit-ticket.output.payload.issueKey}}",
          "labels": ["compliance", "audit"]
        }
      }
    }
  ],
  "connections": [
    { "from": "trigger-card", "to": "open-audit-ticket", "type": "success" },
    { "from": "open-audit-ticket", "to": "approve-audit", "type": "success" },
    { "from": "approve-audit", "to": "collect-evidence", "type": "success" },
    { "from": "collect-evidence", "to": "document-audit", "type": "success" }
  ]
}
