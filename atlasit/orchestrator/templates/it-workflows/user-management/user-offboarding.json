{
  "name": "User Offboarding Workflow",
  "description": "Automated user offboarding across key IT systems with change documentation",
  "category": "user-management",
  "version": "1.1.0",
  "metadata": {
    "author": "AtlasIT",
    "tags": ["offboarding", "identity", "automation"],
    "estimatedDuration": "10 minutes",
    "complexity": "medium",
    "changeManagement": "Simulated Jira approvals and Confluence documentation available via connector aliases"
  },
  "resources": {
    "connectors": {
      "activeDirectory": "{{connectors.activeDirectory}}",
      "office365": "{{connectors.office365}}",
      "slack": "{{connectors.slack}}",
      "jira": "{{connectors.jira}}",
      "confluence": "{{connectors.confluence}}"
    }
  },
  "cards": [
    {
      "id": "trigger-card",
      "type": "trigger",
      "name": "Offboarding Request",
      "config": {
        "triggerType": "webhook",
        "schema": {
          "type": "object",
          "required": ["email", "lastDay"],
          "properties": {
            "email": { "type": "string", "format": "email" },
            "lastDay": { "type": "string", "format": "date" },
            "managerEmail": { "type": "string", "format": "email" }
          }
        }
      },
      "outputs": {
        "user": "user"
      }
    },
    {
      "id": "disable-ad",
      "type": "connector-action",
      "name": "Disable Active Directory Account",
      "config": {
        "connector": "activeDirectory",
        "action": "disable-user",
        "parameters": {
          "email": "{{user.email}}",
          "reason": "Scheduled offboarding"
        }
      }
    },
    {
      "id": "disable-m365",
      "type": "connector-action",
      "name": "Disable Microsoft 365",
      "config": {
        "connector": "office365",
        "action": "assign-license",
        "parameters": {
          "email": "{{user.email}}",
          "licenses": []
        }
      }
    },
    {
      "id": "remove-slack",
      "type": "connector-action",
      "name": "Remove Slack Access",
      "config": {
        "connector": "slack",
        "action": "assign-channels",
        "parameters": {
          "email": "{{user.email}}",
          "channels": []
        }
      }
    },
    {
      "id": "jira-ticket",
      "type": "connector-action",
      "name": "Create Offboarding Change Ticket",
      "config": {
        "connector": "jira",
        "action": "create-issue",
        "parameters": {
          "projectKey": "OPS",
          "summary": "Offboard {{user.email}}",
          "description": "Disable accounts and update documentation",
          "changeType": "Standard",
          "approvers": ["ops-lead@example.com"]
        }
      }
    },
    {
      "id": "approve-jira",
      "type": "connector-action",
      "name": "Approve Offboarding Ticket",
      "config": {
        "connector": "jira",
        "action": "transition-issue",
        "parameters": {
          "issueKey": "{{card.jira-ticket.output.payload.issueKey}}",
          "status": "Approved"
        }
      }
    },
    {
      "id": "publish-docs",
      "type": "connector-action",
      "name": "Publish Offboarding Notes",
      "config": {
        "connector": "confluence",
        "action": "publish-page",
        "parameters": {
          "spaceKey": "OPS",
          "title": "Offboarding - {{user.email}}",
          "body": "Offboarding completed, Jira ticket {{card.jira-ticket.output.payload.issueKey}}",
          "labels": ["offboarding", "change-management"]
        }
      }
    },
    {
      "id": "notify-manager",
      "type": "notification",
      "name": "Notify Manager",
      "config": {
        "type": "email",
        "recipients": ["{{user.managerEmail}}"],
        "template": "offboarding-complete",
        "variables": {
          "email": "{{user.email}}",
          "lastDay": "{{user.lastDay}}"
        }
      }
    }
  ],
  "connections": [
    { "from": "trigger-card", "to": "disable-ad", "type": "success" },
    { "from": "disable-ad", "to": "disable-m365", "type": "success" },
    { "from": "disable-m365", "to": "remove-slack", "type": "success" },
    { "from": "remove-slack", "to": "jira-ticket", "type": "success" },
    { "from": "jira-ticket", "to": "approve-jira", "type": "success" },
    { "from": "approve-jira", "to": "publish-docs", "type": "success" },
    { "from": "publish-docs", "to": "notify-manager", "type": "success" }
  ]
}
