{
  "name": "User Profile Synchronization",
  "description": "Synchronize core user attributes across simulated directory systems",
  "category": "user-management",
  "version": "2.0.0",
  "metadata": {
    "author": "AtlasIT",
    "tags": ["profile", "sync", "automation"],
    "estimatedDuration": "5 minutes",
    "complexity": "medium"
  },
  "resources": {
    "connectors": {
      "activeDirectory": "{{connectors.activeDirectory}}",
      "office365": "{{connectors.office365}}",
      "slack": "{{connectors.slack}}"
    }
  },
  "cards": [
    {
      "id": "trigger-card",
      "type": "trigger",
      "name": "Profile Update Request",
      "config": {
        "triggerType": "webhook",
        "schema": {
          "type": "object",
          "required": ["email", "firstName", "lastName"],
          "properties": {
            "email": { "type": "string", "format": "email" },
            "firstName": { "type": "string" },
            "lastName": { "type": "string" },
            "displayName": { "type": "string" },
            "department": { "type": "string" },
            "jobTitle": { "type": "string" },
            "phone": { "type": "string" }
          }
        }
      },
      "outputs": {
        "profile": "profile"
      }
    },
    {
      "id": "update-ad",
      "type": "connector-action",
      "name": "Update Active Directory",
      "config": {
        "connector": "activeDirectory",
        "action": "assign-groups",
        "parameters": {
          "email": "{{profile.email}}",
          "groups": ["Employees", "{{profile.department}}"]
        }
      }
    },
    {
      "id": "sync-ad-details",
      "type": "connector-action",
      "name": "Sync AD Profile Details",
      "config": {
        "connector": "activeDirectory",
        "action": "create-user",
        "parameters": {
          "email": "{{profile.email}}",
          "firstName": "{{profile.firstName}}",
          "lastName": "{{profile.lastName}}",
          "department": "{{profile.department}}"
        }
      }
    },
    {
      "id": "sync-m365",
      "type": "connector-action",
      "name": "Sync Microsoft 365 Profile",
      "config": {
        "connector": "office365",
        "action": "create-user",
        "parameters": {
          "email": "{{profile.email}}",
          "firstName": "{{profile.firstName}}",
          "lastName": "{{profile.lastName}}",
          "licenses": []
        }
      }
    },
    {
      "id": "update-slack",
      "type": "connector-action",
      "name": "Update Slack Display",
      "config": {
        "connector": "slack",
        "action": "assign-channels",
        "parameters": {
          "email": "{{profile.email}}",
          "channels": ["general"]
        }
      }
    }
  ],
  "connections": [
    { "from": "trigger-card", "to": "update-ad", "type": "success" },
    { "from": "update-ad", "to": "sync-ad-details", "type": "success" },
    { "from": "sync-ad-details", "to": "sync-m365", "type": "success" },
    { "from": "sync-m365", "to": "update-slack", "type": "success" }
  ]
}
