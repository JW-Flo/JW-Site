---
import Layout from '../components/Layout.astro';
---
<Layout title="AtlasIT Automation Demos">
  <section class="max-w-2xl mx-auto py-12">
    <h1 class="text-3xl font-bold mb-6">AtlasIT Automation Demos</h1>
    <ul class="space-y-4">
      <li>
        <a href="/aws-iam-demo" class="text-blue-400 hover:underline text-lg font-semibold">
          AWS IAM Terraform Automation Demo
        </a>
        <p class="text-slate-400 text-sm">Provision AWS IAM users, roles, and permissions automatically with Terraform.</p>
      </li>
      <li>
        <a href="/workflow-builder" class="text-blue-400 hover:underline text-lg font-semibold">
          IAM Automation Workflow Builder
        </a>
        <p class="text-slate-400 text-sm">Request, approve, and automate IAM changes across all systems with a simulated 3-step approval and real provisioning logic.</p>
      </li>
      <li>
        <a href="/demo-reset" class="text-blue-400 hover:underline text-lg font-semibold">
          Reset Demo Data
        </a>
        <p class="text-slate-400 text-sm">Restore all demo data for the IAM Automation Workflow Builder to its initial state.</p>
      </li>
    </ul>
  </section>
</Layout>
