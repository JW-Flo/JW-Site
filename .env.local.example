# Local development example (do not commit real secrets)
# Copy to .env.local and fill in values.

# --- Core Secrets ---
SESSION_SIGNING_KEY=changeme-session-hmac
SUPER_ADMIN_KEY=changeme-super-admin
CONSENT_ADMIN_KEY=changeme-consent-admin

# --- Feature Flags ---
FEATURE_CONSENT_D1=false
FEATURE_WAITLIST=false
FEATURE_GEO_CLASSIFICATION=false

# --- Enrichment Flags ---
# Enable optional OpenCVE keyword stats
OPENCVE_ENRICH=true
# Optional: override API base (default https://app.opencve.io/api)
OPENCVE_API_BASE=https://app.opencve.io/api
# OpenCVE auth precedence: Basic > Token > none
OPENCVE_USERNAME=
OPENCVE_PASSWORD=
OPENCVE_API_TOKEN=

# VirusTotal domain reputation
VIRUSTOTAL_API_KEY=

# --- Other Optional Keys ---
NVD_API_KEY=

# NOTE: This file is an example only. Actual .env.local is ignored by git.
