{
  "name": "atlasit-monorepo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "apps/awhittlewandering"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "dev:atlasit": "npm run dev --workspace apps/atlasit-sveltekit",
    "build:atlasit": "npm run build --workspace apps/atlasit-sveltekit",
    "deploy:atlasit:pages": "npm run deploy:pages --workspace apps/atlasit-sveltekit",
    "lint": "npm run lint --workspaces",
    "lint:ts": "eslint \"apps/*/src/**/*.{ts,tsx,js,svelte,astro,vue}\" \"packages/**/*.{ts,tsx,js}\" \"src/**/*.{ts,tsx,js,svelte,astro,vue}\"",
    "lint:types": "ESLINT_TYPEAWARE=1 eslint \"apps/atlasit-sveltekit/src/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "lint:fix": "npm run lint:ts -- --fix",
    "test": "npm run test --workspaces",
    "test:atlasit": "npm test --workspace apps/atlasit-sveltekit -- --run",
    "check:atlasit": "npm run check --workspace apps/atlasit-sveltekit",
    "tf:validate": "cd infra/cloudflare && terraform init -input=false && terraform validate",
    "install:all": "npm install",
    "preview:jw-immersive:static": "echo 'jw-immersive removed; use https://www.atlasit.pro (redirects to /console)' && exit 0",
    "demo:refresh": "node scripts/demo-refresh.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "connectors:check": "node scripts/check-connector-transition.mjs",
    "check:edge": "if grep -r 'node:' apps/atlasit-sveltekit/src/; then echo 'Node APIs found in edge app'; exit 1; else echo 'Edge-safe'; fi"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.6.7",
    "@astrojs/mdx": "^4.3.4",
    "@astrojs/rss": "^4.0.7",
    "@astrojs/sitemap": "^3.1.0",
    "@astrojs/tailwind": "^5.1.0",
    "@astrojs/vue": "^5.1.1",
    "@dotenvx/dotenvx": "^1.49.0",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "astro": "^5.13.5",
    "autoprefixer": "^10.4.20",
    "axios": "^1.12.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.2",
    "hono": "^4.9.6",
    "postcss": "^8.4.41",
    "puppeteer": "^24.17.1",
    "tailwindcss": "^3.4.7",
    "tslib": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250830.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "eslint-config-prettier": "^9.1.0",
    "astro-eslint-parser": "^1.0.3",
    "eslint-plugin-astro": "^1.2.0",
    "eslint-plugin-svelte": "^2.44.1",
    "svelte-eslint-parser": "^0.41.1",
    "vue-eslint-parser": "^9.4.3",
    "eslint": "^9.34.0",
    "express": "^4.18.0",
    "jsdom": "^25.0.1",
    "node-fetch": "^2.7.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^4.33.1"
  }
}
