{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "apps/**/*.{ts,tsx,vue,astro}",
    "packages/**/*.{ts,tsx}",
    "atlasit/**/*.{ts,tsx}",
  "apps/**/.svelte-kit/types/**/*.{d.ts,ts}",
  "apps/**/.svelte-kit/generated/**/*.{d.ts,ts,js}",
    "**/*.cjs",
    "**/*.mjs",
    "scripts/**/*.{ts,js,mjs,cjs}",
    "*.cts",
    "*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
  "coverage",
  "**/.svelte-kit/**"
  ]
}
